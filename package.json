{
  "name": "alida-portfolio",
  "version": "1.0.0",
  "description": "Portfolio of \u00c1lida D\u00edaz de Freijo",
  "scripts": {
    "dev": "astro dev",
    "tokens": "node scripts/tokens.mjs",
    "check:system": "node scripts/check-system.mjs",
    "check": "node scripts/tokens.mjs --check && node scripts/check-system.mjs",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "build:static": "npm run check && PREVIEW=1 astro build && node scripts/relativize.mjs",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/vercel": "^11.0.16",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^7.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "type": "module",
  "private": true
}
