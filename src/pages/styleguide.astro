---
/**
 * Styleguide · GENERATED from the system, not written by hand.
 * Tokens come from src/styles/tokens.json (made from estilos/tokens.css) and
 * the components from src/components/system/manifest.json: add a token or a
 * component there and it shows up here. Nothing on this page has its own
 * values; it is checked like any other page.
 */
import Base from '../layouts/Base.astro';
import Panel from '../components/system/Panel.astro';
import Label from '../components/system/Label.astro';
import tokens from '../styles/tokens.json';
import manifest from '../components/system/manifest.json';
import { accentVars } from '../lib/utils';

const mods = import.meta.glob('../components/system/*.astro', { eager: true }) as Record<string, { default: any }>;
const comp = (file: string) => mods[file.replace('src/components/system/', '../components/system/')]?.default;

type T = { $value: any; $description?: string; $extensions: { 'portfolio.css': { variable: string; value?: string } } };
const list = (group: Record<string, any>) => Object.entries(group).map(([key, t]) => ({ key, ...(t as T), v: (t as T).$extensions['portfolio.css'].variable }));
const agents = Object.keys(tokens.agent);
const colours = list(tokens.color).filter((c) => !agents.includes(c.key) && !agents.some((a) => c.key === `on-${a}`));
const type = list(tokens.type).filter((t) => t.key.startsWith('fs-'));
const families = list(tokens.fontFamily);
const space = list(tokens.space);
const radii = list(tokens.radius);
const durations = list(tokens.duration);
const easings = list(tokens.easing);
const familyOf: Record<string, string> = { 'fs-display': '--font-serif', 'fs-section': '--font-serif', 'fs-chapter': '--font-serif', 'fs-text': '--font-body', 'fs-label': '--font-ui' };
const sample: Record<string, string> = { 'fs-display': '<em>Yep,</em> that’s me.', 'fs-section': 'In <em>short</em>', 'fs-chapter': 'The <em>role</em>', 'fs-text': 'Turning messy ideas into things people actually use.', 'fs-label': 'Systems agent · 2024' };
const val = (t: any) => t.$extensions['portfolio.css'].value || (typeof t.$value === 'object' && t.$value?.unit ? `${t.$value.value}${t.$value.unit}` : String(t.$value));
const sections = ['Colour', 'Agents', 'Type', 'Space', 'Radius', 'Shadow', 'Motion', 'Components'];
---
<Base title="styleguide" description="The design system behind this portfolio, generated from its tokens and components.">
  <Panel class="sg" label="Styleguide">
    <header class="sg__top">
      <h1 class="type-display">The <em>system</em></h1>
      <p class="type-text sg__lead">Generated from the tokens (<code>estilos/tokens.css</code>) and the component manifest. If it is not here, it is not part of the site. Rules in plain words: <code>DESIGN.md</code>.</p>
      <nav class="sg__nav" aria-label="Sections">{sections.map((s) => <a href={`#${s.toLowerCase()}`} class="type-label">{s}</a>)}</nav>
    </header>

    <section id="colour" class="sg__sec">
      <h2 class="type-section">Colour</h2>
      <div class="sw">
        {colours.map((c) => (
          <figure class="sw__i">
            <div class="sw__c" style={`background: var(${c.v})`}></div>
            <figcaption><Label tone="ink">{c.v}</Label><span class="type-text">{c.$value}</span><span class="type-text sg__muted">{c.$description}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section id="agents" class="sg__sec">
      <h2 class="type-section">Agents</h2>
      <p class="type-text sg__muted">Each case wears the pair of its agent: background and the text that reads on it.</p>
      <div class="ag">
        {agents.map((a) => (
          <div class="ag__i" style={accentVars(a)}>
            <span class="type-chapter">{a}</span>
            <span class="type-label">--{a} · --on-{a}</span>
            <span class="type-text">{(tokens.agent as any)[a].$description}</span>
          </div>
        ))}
      </div>
    </section>

    <section id="type" class="sg__sec">
      <h2 class="type-section">Type</h2>
      <p class="type-text sg__muted">Three families, five sizes. Nothing outside the scale.</p>
      <dl class="fam">{families.map((f) => <div><dt><Label>{f.v}</Label></dt><dd class="type-text" style={`font-family: var(${f.v})`}>{f.$value[0]} · {f.$description}</dd></div>)}</dl>
      <div class="ty">
        {type.map((t) => (
          <div class="ty__i">
            <div class="ty__m"><Label tone="ink">{t.v}</Label><span class="type-text sg__muted">{val(t)} · {familyOf[t.key]}</span><span class="type-text sg__muted">{t.$description}</span></div>
            <p class:list={[`type-${t.key.replace('fs-', '')}`, 'ty__s']} set:html={sample[t.key]} />
          </div>
        ))}
      </div>
    </section>

    <section id="space" class="sg__sec">
      <h2 class="type-section">Space</h2>
      <div class="sp">{space.map((s) => <div class="sp__i"><span class="sp__b" style={`width: var(${s.v})`}></span><Label tone="ink">{s.v}</Label><span class="type-text sg__muted">{val(s)}{s.$description ? ` · ${s.$description}` : ''}</span></div>)}</div>
    </section>

    <section id="radius" class="sg__sec">
      <h2 class="type-section">Radius</h2>
      <div class="rd">{radii.map((r) => <div class="rd__i"><span class="rd__b" style={`border-radius: var(${r.v})`}></span><Label tone="ink">{r.v}</Label><span class="type-text sg__muted">{val(r)} · {r.$description}</span></div>)}</div>
    </section>

    <section id="shadow" class="sg__sec">
      <h2 class="type-section">Shadow</h2>
      <div class="sh-demo"><span class="sh-demo__b"></span><div><Label tone="ink">--shadow-card</Label><p class="type-text sg__muted">{tokens.shadow.card.$description} No other shadow, no blur, no gradient.</p></div></div>
    </section>

    <section id="motion" class="sg__sec">
      <h2 class="type-section">Motion</h2>
      <p class="type-text sg__muted">With “reduce motion”, every duration is 0.</p>
      <div class="mo">
        {durations.map((d) => <div class="mo__i"><span class="mo__dot" style={`--d: var(${d.v})`}></span><Label tone="ink">{d.v}</Label><span class="type-text sg__muted">{val(d)}</span></div>)}
        {easings.map((e) => <div class="mo__i"><span class="mo__dot" style={`--e: var(${e.v})`}></span><Label tone="ink">{e.v}</Label><span class="type-text sg__muted">{e.$description || 'curve'}</span></div>)}
      </div>
    </section>

    <section id="components" class="sg__sec">
      <h2 class="type-section">Components</h2>
      <p class="type-text sg__muted">{manifest.components.length} base components. Each one: what it is for, when to use it, when not, and a live example.</p>
      <div class="cp">
        {manifest.components.map((c: any) => {
          const Comp = comp(c.file);
          const examples = [c.example, ...(c.variants || [])];
          return (
            <article class="cp__i" id={`c-${c.name}`}>
              <div class="cp__info">
                <h3 class="type-chapter">{c.name}</h3>
                <p class="type-text">{c.purpose}</p>
                <dl class="cp__dl">
                  <div><dt><Label>Use</Label></dt><dd class="type-text">{c.use}</dd></div>
                  <div><dt><Label>Avoid</Label></dt><dd class="type-text">{c.avoid}</dd></div>
                </dl>
                <Label>{c.file}</Label>
              </div>
              <div class:list={['cp__stage', { 'cp__stage--ink': c.background === 'ink' }]} style={c.example.accent ? accentVars(c.example.accent) : undefined}>
                {examples.map((ex: any) => Comp && (
                  c.example.wrap === 'dl'
                    ? <dl class="cp__wrap"><Comp {...ex.props}>{ex.slot}</Comp></dl>
                    : <Comp {...ex.props}>{ex.slot}</Comp>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </Panel>
</Base>

<style>
  .sg { display: flex; flex-direction: column; gap: var(--s-8); }
  .sg code { font-family: var(--font-ui); font-size: var(--fs-label); }
  .sg__top { display: flex; flex-direction: column; gap: var(--s-5); }
  .sg__lead { max-width: 60ch; }
  .sg__muted { color: var(--muted); }
  .sg__nav { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .sg__nav a { text-decoration: underline; text-underline-offset: 0.3em; }
  .sg__sec { display: flex; flex-direction: column; gap: var(--s-5); padding-top: var(--s-6); border-top: 1px solid var(--line); }

  .sw { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--s-4); }
  .sw__i { margin: 0; display: flex; flex-direction: column; gap: var(--s-2); }
  .sw__c { height: 72px; border-radius: var(--r-sm); outline: 1px solid var(--line); }
  .sw__i figcaption { display: flex; flex-direction: column; gap: var(--s-1); }

  .ag { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--s-3); }
  .ag__i { display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-5) var(--s-4); border-radius: var(--r-sm); background: var(--acc); color: var(--on-acc); }

  .fam { display: grid; gap: var(--s-3); margin: 0; }
  .fam div { display: grid; grid-template-columns: 140px 1fr; gap: var(--s-4); align-items: baseline; }
  .fam dd { margin: 0; }
  .ty { display: flex; flex-direction: column; }
  .ty__i { display: grid; grid-template-columns: minmax(180px, 1fr) 3fr; gap: var(--s-5); padding: var(--s-5) 0; border-top: 1px solid var(--line); align-items: baseline; }
  .ty__m { display: flex; flex-direction: column; gap: var(--s-1); }
  .ty__s { margin: 0; overflow-wrap: anywhere; }

  .sp, .rd, .mo { display: grid; gap: var(--s-3); }
  .sp__i { display: grid; grid-template-columns: 72px 100px 1fr; gap: var(--s-4); align-items: center; }
  .sp__b { display: block; height: 16px; background: var(--ink); }
  .rd { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--s-4); }
  .rd__i { display: flex; flex-direction: column; gap: var(--s-2); }
  .rd__b { display: block; height: 72px; background: var(--paper-2); outline: 1px solid var(--line); }
  .sh-demo { display: flex; gap: var(--s-6); align-items: center; flex-wrap: wrap; }
  .sh-demo__b { width: 160px; height: 100px; border-radius: var(--r-md); background: var(--paper-2); box-shadow: var(--shadow-card); }
  .mo { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--s-4); }
  .mo__i { display: flex; flex-direction: column; gap: var(--s-2); }
  .mo__dot { display: block; width: 24px; height: 24px; border-radius: var(--r-pill); background: var(--red); transition: transform var(--d, var(--dur-slow)) var(--e, var(--ease-out)); }
  .mo__i:hover .mo__dot { transform: translateX(80px); }

  .cp { display: flex; flex-direction: column; }
  .cp__i { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--s-6); padding: var(--s-6) 0; border-top: 1px solid var(--line); }
  .cp__info { display: flex; flex-direction: column; gap: var(--s-3); }
  .cp__dl { display: grid; gap: var(--s-3); margin: 0; }
  .cp__dl div { display: flex; flex-direction: column; gap: var(--s-1); }
  .cp__dl dd { margin: 0; }
  .cp__stage { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--s-4); padding: var(--s-6); border-radius: var(--r-sm); background: var(--paper-2); min-height: 160px; }
  .cp__stage > :global(*) { max-width: 100%; }
  .cp__stage :global(.vb), .cp__stage :global(.nc), .cp__stage :global(.tc), .cp__stage :global(.dc), .cp__stage :global(.panel), .cp__stage :global(.sh), .cp__stage :global(.ft) { width: 100%; }
  .cp__stage--ink { background: var(--ink); }
  .cp__wrap { margin: 0; }

  @media (max-width: 809px) {
    .ty__i, .cp__i { grid-template-columns: 1fr; gap: var(--s-4); }
    .sp__i { grid-template-columns: 48px 90px 1fr; }
    .fam div { grid-template-columns: 1fr; gap: var(--s-1); }
    .cp__stage { padding: var(--s-4); }
  }
</style>
