---
/** 404 · built with the system (Panel, type classes, Button). */
import Base from '../layouts/Base.astro';
import Panel from '../components/system/Panel.astro';
import Button from '../components/system/Button.astro';
---
<Base title="not found">
  <Panel class="nf" label="Page not found">
    <img src="/images/faces/messy-hair.png" alt="" width="140" height="140" />
    <h1 class="type-section">This page is still in a <em>Figma graveyard</em></h1>
    <p class="type-text nf__p">Or it never existed. Either way, let’s get you somewhere useful.</p>
    <div class="nf__b"><Button href="/" arrow="→">Home</Button><Button href="/play" arrow="→">Play</Button><Button href="/work" arrow="→">Work</Button></div>
  </Panel>
</Base>

<style>
  .nf__b { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); margin-top: var(--s-3); }
</style>
<style is:global>
  .panel.nf { min-height: calc(100vh - 140px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--s-4); text-align: center; }
  .panel.nf h1 { max-width: 16ch; margin: 0; }
  .panel.nf .nf__p { color: var(--muted); }
</style>
