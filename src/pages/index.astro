---
/**
 * Home · v2. The new header on the frame, the faces spread over the panel
 * around a big headline (they light up, talk and open a case), and an index
 * of small print. Scrolling shrinks the faces panel and the index rises into
 * the same screen; after that the page ends.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Faces from '../components/Faces.astro';
import { getEntry, getCollection } from 'astro:content';
const home = (await getEntry('pages', 'home'))!.data as any;
const projects = (await getCollection('projects'))
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => a.data.order - b.data.order);
const work = projects.map((p, i) => {
  const type = p.data.meta.find((m) => m.label === 'Project')?.value || '';
  return {
    n: String(i + 1).padStart(2, '0'),
    href: `/work/${p.id}`,
    title: p.data.title,
    type: type.toLowerCase() === p.data.title.toLowerCase() ? '' : type,
    year: p.data.meta.find((m) => m.label === 'Year')?.value || '',
    exploration: p.data.kind === 'exploration',
  };
});
const now: string[] = home.now || [];
const before: string = home.before || '';
const caps: string[] = home.capabilities || [];
---
<Base nav={false}>
  <div class="hw" data-hw>
    <div class="hp">
      <SiteHeader />
      <section class="home" data-panel>
        <div class="home__stage" data-stage>
          <Faces />
          <div class="home__intro">
            <h1 class="home__title"><span class="w1">{home.lead}</span> <span class="w2">{home.title}</span></h1>
            <p class="home__role">{home.role}</p>
            <p class="home__line">{home.sub}</p>
          </div>
        </div>
        <p class="home__hint home__hint--l" aria-hidden="true">Hover a face · each one opens a case</p>
        <p class="home__hint home__hint--c" aria-hidden="true">Scroll ↓</p>
      </section>

      <section class="hx" aria-label="Index" data-index>
        <div class="hx__col hx__work">
          <p class="hx__lab">Selected work</p>
          <ul>
            {work.map((w) => (
              <li><a href={w.href} class:list={['hx__row', { 'is-soft': w.exploration }]}>
                <span class="hx__n">{w.n}</span>
                <span class="hx__t">{w.title}{w.type && <span class="hx__type"> · {w.type}</span>}</span>
                <span class="hx__y">{w.year}</span>
              </a></li>
            ))}
          </ul>
        </div>
        {now.length > 0 && (
          <div class="hx__col">
            <p class="hx__lab">Now</p>
            {now.map((l) => <p class="hx__val">{l}</p>)}
            {before && <><p class="hx__lab hx__gap">Before</p><p class="hx__val">{before}</p></>}
          </div>
        )}
        {caps.length > 0 && (
          <div class="hx__col">
            <p class="hx__lab">Capabilities</p>
            {caps.map((l) => <p class="hx__val">{l}</p>)}
          </div>
        )}
        <div class="hx__col hx__count">
          <p class="hx__lab">Cases</p>
          <p class="hx__big">{String(work.length).padStart(2, '0')}</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  // Scroll shrink (desktop and tablet): the screen stays put while you scroll
  // a short runway; the panel loses height, its contents scale down with it
  // the words shrink, the faces tidy up, and the index rises from below.
  function initShrink() {
    const wrap = document.querySelector<HTMLElement>('[data-hw]');
    if (!wrap || wrap.dataset.ready) return; wrap.dataset.ready = '1';
    const panel = wrap.querySelector<HTMLElement>('[data-panel]')!;
    const index = wrap.querySelector<HTMLElement>('[data-index]')!;
    const mq = matchMedia('(min-width: 810px) and (prefers-reduced-motion: no-preference)');
    let full = 0, small = 0, run = 0, raf = 0, tidied = false;
    const measure = () => {
      wrap.style.removeProperty('--ph');
      if (!mq.matches) { wrap.classList.remove('is-shrink'); return; }
      wrap.classList.add('is-shrink');
      const hp = wrap.firstElementChild as HTMLElement;
      const header = hp.firstElementChild as HTMLElement;
      full = hp.clientHeight - header.offsetHeight;
      small = Math.max(320, full - index.offsetHeight);
      run = Math.max(1, full - small);
      wrap.style.setProperty('--run', run + 'px');
      wrap.style.setProperty('--ph0', full + 'px');
      update();
    };
    const update = () => {
      raf = 0;
      if (!mq.matches || !wrap.isConnected) return;
      const p = Math.min(1, Math.max(0, (scrollY - wrap.offsetTop + 12) / run));
      const h = full - (full - small) * p;
      wrap.style.setProperty('--ph', h + 'px');
      // the faces go home as soon as the panel starts to shrink; they keep their size
      if (p > 0.01 && !tidied) { tidied = true; dispatchEvent(new Event('faces:tidy')); }
      if (p <= 0.01) tidied = false;
      wrap.style.setProperty('--p', p.toFixed(3));
    };
    const onScroll = () => { if (!wrap.isConnected) { removeEventListener('scroll', onScroll); return; } if (!raf) raf = requestAnimationFrame(update); };
    measure();
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    mq.addEventListener('change', measure);
    document.fonts?.ready.then(measure);
  }
  initShrink();
  document.addEventListener('astro:page-load', initShrink);
</script>

<style>
  .hw { --print: clamp(12px, 0.84vw, 14px); --home-red: #B0161B; /* the accent red, darkened to read on paper */ }
  .hp { min-height: calc(100svh - var(--frame) * 2); display: flex; flex-direction: column; }
  .home {
    position: relative; flex: 1; min-height: 560px;
    background: var(--paper); border-radius: var(--r-md); overflow: hidden;
  }
  .home__stage { position: absolute; inset: 0; }

  /* shrink mode: a runway of scroll, the screen sticky on top of it */
  .hw.is-shrink { height: calc(100svh - var(--frame) * 2 + var(--run, 0px)); }
  .hw.is-shrink .hp { position: sticky; top: var(--frame); height: calc(100svh - var(--frame) * 2); min-height: 0; overflow: hidden; }
  .hw.is-shrink .home { flex: none; height: var(--ph, auto); min-height: 0; }
  /* as it shrinks, only the words get smaller */
  .hw.is-shrink .home__intro { scale: calc(1 - var(--p, 0) * 0.4); }
  .hw.is-shrink .home__hint { opacity: calc(0.6 - var(--p, 0) * 0.6); }

  /* The faces sit above this block, so they can be dragged over it. */
  .home__intro {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; z-index: 1;
    width: min(74%, 1100px); text-align: center; pointer-events: none;
    display: flex; flex-direction: column; align-items: center;
  }
  /* Headline in Instrument Serif, "Yep," in italic. */
  .home__title {
    margin: 0; font-family: var(--font-serif); font-weight: 400; text-wrap: balance;
    font-size: clamp(67px, 9.9vw, 200px); line-height: 0.8; letter-spacing: -0.035em;
  }
  .home__title .w1 { font-style: italic; letter-spacing: -0.02em; }
  .home__role, .home__line {
    margin: 0; font-family: var(--font-display); font-weight: 500; text-transform: uppercase;
    font-size: clamp(16px, 1.45vw, 26px); line-height: 1.15; color: var(--home-red);
  }
  .home__role { margin-top: clamp(30px, 3.2vw, 60px); }
  .home__line { text-wrap: balance; }
  .home__hint {
    position: absolute; bottom: 14px; margin: 0; z-index: 3; pointer-events: none;
    font-family: var(--font-body); font-size: var(--print); line-height: 1.45; color: var(--muted); opacity: 0.6;
  }
  .home__hint--l { left: 18px; }
  .home__hint--c { left: 50%; translate: -50% 0; }

  /* entry: on top of the panel opening and the faces popping, the words blur in */
  :global(html.pre-enter) .home__title, :global(html.pre-enter) .home__role, :global(html.pre-enter) .home__line { opacity: 0; }
  :global(.home.is-entering) .home__title { animation: blur-in 900ms cubic-bezier(.22,.75,.25,1) 250ms both; }
  :global(.home.is-entering) .home__role { animation: blur-in 800ms cubic-bezier(.22,.75,.25,1) 1050ms both; }
  :global(.home.is-entering) .home__line { animation: blur-in 800ms cubic-bezier(.22,.75,.25,1) 1150ms both; }
  @keyframes blur-in { from { opacity: 0; filter: blur(12px); translate: 0 8px; } to { opacity: 1; filter: blur(0); translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { :global(.home.is-entering) :is(.home__title, .home__role, .home__line) { animation: none; } }

  /* index: small print on the frame */
  .hx {
    flex: none;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 16px; row-gap: 28px;
    padding: 24px 12px 18px; color: var(--on-chrome);
  }
  .hx p { margin: 0; }
  .hx ul { list-style: none; margin: 0; padding: 0; }
  .hx__lab, .hx__val, .hx__row { font-family: var(--font-body); font-size: var(--print); line-height: 1.5; letter-spacing: 0.02em; }
  .hx__lab { color: var(--muted-ink); margin-bottom: 4px !important; }
  .hx__gap { margin-top: 14px !important; }
  .hx__col { grid-column: span 3; }
  .hx__work { grid-column: span 4; }
  .hx__count { grid-column: span 2; text-align: right; }
  .hx__row { display: grid; grid-template-columns: 2.2em minmax(0, 1fr) auto; gap: 10px; padding: 1px 0; transition: opacity 240ms var(--ease-out); }
  .hx__row.is-soft { opacity: 0.6; }
  .hx__t::first-letter { text-transform: uppercase; }
  .hx__type { color: var(--muted-ink); }
  .hx ul:hover .hx__row { opacity: 0.4; }
  .hx ul:hover .hx__row:hover { opacity: 1; }
  .hx__row:hover .hx__t { text-decoration: underline; text-underline-offset: 2px; }
  .hx__big { font-family: var(--font-display); font-weight: 300; font-size: clamp(64px, 6vw, 110px); line-height: 0.9; letter-spacing: -0.04em; }

  @media (max-width: 1099px) {
    .hx__work { grid-column: span 7; }
    .hx__col { grid-column: span 5; }
    .hx__col:nth-child(3) { grid-column: span 7; }
    .hx__count { grid-column: span 5; }
  }
  @media (max-width: 809px) {
    .home__intro { top: auto; bottom: 36px; translate: -50% 0; width: min(88%, 340px); }
    .home__title { font-size: 46px; }
    .home__role { font-size: 14px; margin-top: 18px; }
    .home__line { font-size: 13px; }
    .home__hint { display: none; }
    .hx { grid-template-columns: 1fr 1fr; }
    .hx__work { grid-column: 1 / -1; }
    .hx__col, .hx__col:nth-child(3) { grid-column: span 1; }
    .hx__count { display: none; }
  }
</style>
