---
/**
 * Play case · Ali's own webs (DESIGN.md, template 4). The stage on the left
 * shows the material of the chapter being read; the numbered chapters run
 * on the right. Cases with an intro film open on it, full screen under the
 * header; scrolling (or skip, or its end) hands over to the case.
 * Built only with the system.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/system/SiteHeader.astro';
import Panel from '../../components/system/Panel.astro';
import TitleCard from '../../components/system/TitleCard.astro';
import ChapterHeading from '../../components/system/ChapterHeading.astro';
import VideoBlock from '../../components/system/VideoBlock.astro';
import NextCase from '../../components/system/NextCase.astro';
import Button from '../../components/system/Button.astro';
import { existsSync } from 'node:fs';
import { getPlay, projectUrl } from '../../lib/projects';
import { accentVars, rich, emph } from '../../lib/utils';

export async function getStaticPaths() {
  const play = await getPlay();
  return play.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: play[(i + 1) % play.length], index: i + 1, total: play.length } }));
}
const { project, next, index, total } = Astro.props;
const d = project.data;
const pad = (n: number) => String(n).padStart(2, '0');
const sib = (src: string | undefined, ext: string) => { if (!src) return undefined; const f = src.replace(/\.mp4$/, ext); return f !== src && existsSync(`public${f}`) ? f : undefined; };
const facts = d.meta.map((m) => ({ label: m.label, value: m.value }));
const chapters = d.chapters;
// the stage: the first piece of material of each chapter
const stage = chapters.map((c, i) => ({ n: i + 1, m: c.media[0] })).filter((s) => s.m);
const mark = (html: string) => html.replace(/\[PLACEHOLDER[^\]]*\]/g, (m) => `<mark class="ph">${m}</mark>`);
const introWebm = sib(d.introVideo, '.webm');
const introPoster = sib(d.introVideo, '.poster.jpg');
const introMobile = sib(d.introVideo, '-mobile.mp4');
---
<Base title={d.title} description={d.lead || d.teaser} image={d.cover} nav={false}>
  <SiteHeader current={{ label: `Play ${pad(index)} / ${pad(total)}`, value: d.title }} />
  <Panel as="article" label={d.title}>
    <div class="pc" style={accentVars(d.accent)}>
      <div class="pc__stage">
        {stage.map((s, i) => (
          <div class:list={['pc__layer', { 'is-on': i === 0 }]} data-for={s.n} data-stage-layer>
            <VideoBlock src={s.m!.src} poster={s.m!.poster} webm={sib(s.m!.src, '.webm')} width={s.m!.width} height={s.m!.height} alt={s.m!.alt} caption={s.m!.caption} />
          </div>
        ))}
      </div>
      <div class="pc__main">
        <header class="pc__head">
          <TitleCard title={d.display || d.title} facts={facts} />
          {d.intro && <div class="pc__intro" set:html={mark(rich(d.intro))} />}
          {d.links.length > 0 && <div class="pc__links">{d.links.map((l) => <Button href={l.url}>{l.label}</Button>)}</div>}
        </header>
        {chapters.map((c, i) => (
          <section class="pc__ch" data-chapter={i + 1} aria-labelledby={`ch-${i + 1}`}>
            <ChapterHeading n={i + 1} title={c.title} id={`ch-${i + 1}`} />
            {c.text && <div class="pc__text" set:html={mark(rich(c.text))} />}
            {c.media.length > 0 && (
              <div class="pc__media">
                {c.media.map((m, j) => (
                  <div class:list={['pc__m', { 'pc__m--stage': j === 0 }]}>
                    <VideoBlock src={m.src} poster={m.poster} webm={sib(m.src, '.webm')} width={m.width} height={m.height} alt={m.alt} caption={m.caption} />
                  </div>
                ))}
              </div>
            )}
          </section>
        ))}
        {total > 1 && <NextCase href={projectUrl(next)} title={next.data.display || next.data.title} line={next.data.teaser} agent={next.data.accent} />}
      </div>
    </div>
  </Panel>
  {d.introVideo && (
    <div class="intro" data-intro style={accentVars(d.accent)} role="dialog" aria-label={`${d.title}: intro film`}>
      <video muted playsinline preload="none" poster={introPoster}>
        {introMobile && <source src={introMobile} type="video/mp4" media="(max-width: 809px)" />}
        {introWebm && <source src={introWebm} type="video/webm; codecs=av01.0.08M.10" />}
        <source src={d.introVideo} type="video/mp4" />
      </video>
      <div class="intro__bar">
        <p class="intro__name" set:html={emph(d.display || d.title)} />
        <button class="intro__skip" type="button" data-intro-skip>Scroll or skip <span aria-hidden="true">↓</span></button>
      </div>
    </div>
  )}
</Base>

<script>
  // The stage shows the material of the chapter being read.
  function initStage() {
    const stage = document.querySelector<HTMLElement>('.pc__stage');
    if (!stage || stage.dataset.ready) return;
    stage.dataset.ready = '1';
    const layers = [...stage.querySelectorAll<HTMLElement>('.pc__layer')];
    const marks = [...document.querySelectorAll<HTMLElement>('.pc__ch[data-chapter]')];
    let cur = '';
    const pick = () => {
      let id = layers[0]?.dataset.for || '';
      for (const m of marks) if (m.getBoundingClientRect().top < innerHeight * 0.55 && layers.some((l) => l.dataset.for === m.dataset.chapter)) id = m.dataset.chapter!;
      if (id === cur) return;
      cur = id;
      layers.forEach((l) => {
        const on = l.dataset.for === id;
        l.classList.toggle('is-on', on);
        const v = l.querySelector('video');
        // the stage is hidden on narrow screens: there the films live in the chapters
        const shown = stage.offsetParent !== null;
        if (v && on && shown && !matchMedia('(prefers-reduced-motion: reduce)').matches) v.preload = 'auto';
        if (v && !shown) { v.pause(); return; }
        if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) on ? v.play().catch(() => {}) : v.pause();
      });
    };
    addEventListener('scroll', pick, { passive: true });
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', pick), { once: true });
    pick();
  }

  // The intro film plays full screen under the header until the visitor scrolls,
  // skips or it ends. With "reduce motion" there is no takeover at all.
  // It also clears the colour we came in with from /play.
  function initIntro() {
    const ink = document.querySelector<HTMLElement>('html > .ink');
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    const clearInk = () => { if (!ink) return; ink.classList.add(intro ? 'is-fade' : 'is-out'); setTimeout(() => ink.remove(), 800); };
    if (!intro || intro.dataset.ready) { setTimeout(clearInk, 150); return; }
    intro.dataset.ready = '1';
    const v = intro.querySelector('video')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('intro-on');
    scrollTo(0, 0);
    const head = document.querySelector<HTMLElement>('.sh');
    if (head) intro.style.setProperty('--intro-top', `${Math.round(head.getBoundingClientRect().bottom)}px`);
    // reduce motion: no full-screen film; the case starts straight away
    if (reduce) { intro.remove(); document.documentElement.classList.remove('intro-on'); setTimeout(clearInk, 150); return; }
    v.preload = 'auto'; v.play().catch(() => {});
    setTimeout(clearInk, 250);
    let done = false;
    const dismiss = () => {
      if (done) return; done = true;
      removeEventListener('wheel', onWheel); removeEventListener('touchmove', dismiss); removeEventListener('keydown', onKey);
      document.documentElement.classList.remove('intro-on');
      if (reduce) { intro.remove(); return; }
      intro.classList.add('is-gone');
      setTimeout(() => intro.remove(), 600);
    };
    const onWheel = (e: WheelEvent) => { if (e.deltaY > 4) dismiss(); };
    const onKey = (e: KeyboardEvent) => { if (['ArrowDown', 'PageDown', ' ', 'Escape', 'Enter'].includes(e.key)) { e.preventDefault(); dismiss(); } };
    addEventListener('wheel', onWheel, { passive: true });
    addEventListener('touchmove', dismiss, { passive: true });
    addEventListener('keydown', onKey);
    intro.querySelector('[data-intro-skip]')!.addEventListener('click', dismiss);
    v.addEventListener('ended', dismiss);
    intro.querySelector<HTMLElement>('[data-intro-skip]')!.focus({ preventScroll: true });
  }
  initStage(); initIntro();
  document.addEventListener('astro:page-load', () => { initStage(); initIntro(); });
</script>

<style>
  .pc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-8); align-items: start; }
  .pc__stage { position: sticky; top: var(--s-5); display: grid; align-items: center; min-height: calc(100vh - 200px); }
  .pc__layer { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity var(--dur-slow) var(--ease-out), visibility 0s linear var(--dur-slow); }
  .pc__layer.is-on { opacity: 1; visibility: visible; transition: opacity var(--dur-slow) var(--ease-out), visibility 0s; }
  .pc__main { display: flex; flex-direction: column; gap: var(--s-8); min-width: 0; }
  .pc__head { display: flex; flex-direction: column; gap: var(--s-5); }
  .pc__intro, .pc__text { max-width: 60ch; font-family: var(--font-body); font-size: var(--fs-text); line-height: var(--lh-text); }
  .pc__intro :global(p + p), .pc__text :global(p + p) { margin-top: var(--s-4); }
  .pc__links { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .pc__ch { display: flex; flex-direction: column; gap: var(--s-5); scroll-margin-top: var(--s-5); }
  .pc__media { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--s-4); }
  /* on a wide screen the first piece of each chapter is on the stage, not repeated here */
  .pc__m--stage { display: none; }
  .pc :global(.ph) { background: var(--paper-2); color: var(--red-text); font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--ls-label); padding: 0 var(--s-1); border-radius: var(--r-sm); }
  @media (max-width: 1099px) {
    .pc { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .pc__stage { display: none; }
    .pc__m--stage { display: block; }
  }

  /* the intro film, full screen under the header */
  .intro { position: fixed; top: var(--intro-top, 110px); left: var(--frame); right: var(--frame); bottom: var(--frame); z-index: 900; border-radius: var(--r-md); overflow: hidden; background: var(--acc); transition: opacity var(--dur-slow) var(--ease-out); }
  .intro video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* on a phone the film is landscape: show it whole on its colour, not cropped */
  @media (max-width: 809px) { .intro video { object-fit: contain; } }
  .intro.is-gone { opacity: 0; }
  .intro__bar { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-4); padding: var(--s-5); }
  .intro__name { margin: 0; font-family: var(--font-serif); font-size: var(--fs-section); line-height: var(--lh-section); color: var(--paper); mix-blend-mode: difference; }
  .intro__name :global(em) { font-style: italic; }
  .intro__skip {
    all: unset; cursor: pointer; box-sizing: border-box; min-height: 44px; padding: 0 var(--s-4); border-radius: var(--r-pill); display: inline-flex; align-items: center; gap: var(--s-2);
    background: var(--paper); color: var(--ink); font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-label); letter-spacing: var(--ls-label); text-transform: uppercase;
  }
  .intro__skip:hover { background: var(--ink); color: var(--paper); }
  .intro__skip:focus-visible { outline: 2px solid var(--paper); outline-offset: 3px; }
  :global(html.intro-on) { overflow: hidden; }
</style>
