---
/**
 * Project template · ONE template for every project, client case or
 * exploration. Big panel pinned on the left, title pinned on top of the
 * right column, content blocks below, then the next project.
 * Change something here and every project changes with it.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ProjectTitle from '../../components/project/ProjectTitle.astro';
import ProjectNext from '../../components/project/ProjectNext.astro';
import Blocks from '../../components/Blocks.astro';
import { getProjects, projectUrl } from '../../lib/projects';
import { accentVars } from '../../lib/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  // Next = the following project by `order`, looping back to the first.
  return projects.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: projects[(i + 1) % projects.length], prev: projects[(i - 1 + projects.length) % projects.length], index: i + 1, total: projects.length } }));
}

const { project, next, prev, index, total } = Astro.props;
const d = project.data;
const n = next.data;
// Chapters with their own left-panel media: the panel follows the reader.
const chapters = (d.blocks || []).filter((b: any) => b.discriminant === 'chapter' && b.value?.hero).map((b: any) => b.value);
// the intro film in two encodings: AV1 (smaller, sharper) where the browser
// plays it, H.264 otherwise; and its first frame while it loads
import { existsSync } from 'node:fs';
const sib = (ext: string) => { if (!d.introVideo) return undefined; const f = d.introVideo.replace(/\.mp4$/, ext); return existsSync(`public${f}`) ? f : undefined; };
const introWebm = sib('.webm');
const introPoster = sib('.poster.jpg');
const allChapters = (d.blocks || []).filter((b: any) => b.discriminant === 'chapter').map((b: any) => ({ n: b.value.n, title: b.value.title }));
---
<Base title={d.title} description={d.lead || d.teaser} image={d.cover} nav={false}>
  <SiteHeader current={{ label: `Case ${String(index).padStart(2, '0')} / ${String(total).padStart(2, '0')}`, value: d.title }} />
  <div class="project" style={accentVars(d.accent)}>
    <div class="project__left" data-chapters={chapters.length || undefined}>
      <div class="chlayer is-on" data-for="0">
        <ProjectHero src={d.hero} style={d.heroStyle} bg={d.heroBg || undefined} frame={d.heroFrame || undefined} label={d.heroLabel || d.title} />
      </div>
      {chapters.length > 0 && (
        <nav class="dots" aria-label="Jump to a chapter">
          {chapters.map((c: any) => <a href={`#chapter-${c.n}`} class="dots__d" data-dot={c.n} aria-label={`${String(c.n).padStart(2, '0')} ${c.title}`}></a>)}
        </nav>
      )}
      {chapters.map((c: any) => (
        <div class="chlayer" data-for={c.n}>
          <ProjectHero src={c.hero} style={c.heroStyle || 'contain'} bg={c.heroBg || '#0B1620'} label={c.title} />
        </div>
      ))}
    </div>
    <div class="project__right">
      <div class="project__title">
        <ProjectTitle part="bar" display={d.display || d.title} intro={d.intro} meta={d.meta} chapters={allChapters} />
      </div>
      <div class="project__blocks">
        <ProjectTitle part="intro" display={d.display || d.title} intro={d.intro} meta={d.meta} links={d.links} />
        <Blocks blocks={d.blocks} />
        <ProjectNext href={projectUrl(next)} label={n.nextLabel || n.heroLabel || n.title} line={n.teaser} image={n.nextImage || n.cover} />
      </div>
    </div>
  </div>
  {d.introVideo && (
    <div class="intro" data-intro style={accentVars(d.accent)} role="dialog" aria-label={`${d.title}: intro film`}>
      <video muted playsinline autoplay preload="auto" poster={introPoster}>
        {introWebm && <source src={introWebm} type="video/webm; codecs=av01.0.08M.10" />}
        <source src={d.introVideo} type="video/mp4" />
      </video>
      <div class="intro__bar">
        <p class="intro__name" set:html={d.display ? d.display.replace(/\*\*(.+?)\*\*/g, '<em>$1</em>') : d.title} />
        <button class="intro__skip" type="button" data-intro-skip>Scroll or skip <span aria-hidden="true">↓</span></button>
      </div>
    </div>
  )}
</Base>

<script>
  // The left panel shows the chapter being read (only on cases that have chapters).
  function initChapters() {
    const left = document.querySelector<HTMLElement>('.project__left[data-chapters]');
    if (!left || left.dataset.ready) return;
    left.dataset.ready = '1';
    const layers = [...left.querySelectorAll<HTMLElement>('.chlayer')];
    const marks = [...document.querySelectorAll<HTMLElement>('.chap[data-chapter]')].filter((m) => layers.some((l) => l.dataset.for === m.dataset.chapter));
    let cur = '0';
    const pick = () => {
      let id = '0';
      for (const m of marks) if (m.getBoundingClientRect().top < innerHeight * 0.55) id = m.dataset.chapter!;
      if (id === cur) return;
      cur = id;
      document.dispatchEvent(new CustomEvent('chapter:change', { detail: id === '0' ? '1' : id }));
      left.querySelectorAll<HTMLElement>('[data-dot]').forEach((d) => d.classList.toggle('is-on', d.dataset.dot === id));
      layers.forEach((l) => {
        const on = l.dataset.for === id;
        l.classList.toggle('is-on', on);
        const v = l.querySelector('video');
        if (v) on ? v.play().catch(() => {}) : v.pause();
      });
    };
    addEventListener('scroll', pick, { passive: true });
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', pick), { once: true });
    pick();
  }
  initChapters();

  // Intro film: on cases that have one it plays full screen when the case
  // opens. Scrolling (or skip, or the end of the film) sends it into the left
  // panel, where the case carries on. Also clears the colour we came in with.
  function initIntro() {
    const ink = document.querySelector<HTMLElement>('html > .ink');
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    const clearInk = () => { if (!ink) return; if (intro) { ink.classList.add('is-fade'); } else { ink.classList.add('is-out'); } setTimeout(() => ink.remove(), 800); };
    if (!intro || intro.dataset.ready) { setTimeout(clearInk, 150); return; }
    intro.dataset.ready = '1';
    const v = intro.querySelector('video')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('intro-on');
    scrollTo(0, 0);
    const head = document.querySelector<HTMLElement>('.sh');
    if (head) intro.style.setProperty('--intro-top', `${Math.round(head.getBoundingClientRect().bottom)}px`);
    v.play().catch(() => {});
    setTimeout(clearInk, 250);
    let done = false;
    const dismiss = () => {
      if (done) return; done = true;
      removeEventListener('wheel', onWheel); removeEventListener('touchmove', dismiss); removeEventListener('keydown', onKey);
      const left = document.querySelector<HTMLElement>('.project__left');
      const r = left?.getBoundingClientRect(), b = intro.getBoundingClientRect();
      document.documentElement.classList.remove('intro-on');
      if (reduce || !r) { intro.remove(); return; }
      // shrink into the left panel
      intro.style.clipPath = `inset(${Math.max(0, r.top - b.top)}px ${Math.max(0, b.right - r.right)}px ${Math.max(0, b.bottom - Math.min(r.bottom, innerHeight))}px ${Math.max(0, r.left - b.left)}px round 12px)`;
      intro.classList.add('is-going');
      setTimeout(() => { intro.classList.add('is-gone'); setTimeout(() => intro.remove(), 500); }, 750);
    };
    const onWheel = (e: WheelEvent) => { if (e.deltaY > 4) dismiss(); };
    const onKey = (e: KeyboardEvent) => { if (['ArrowDown', 'PageDown', ' ', 'Escape', 'Enter'].includes(e.key)) { e.preventDefault(); dismiss(); } };
    addEventListener('wheel', onWheel, { passive: true });
    addEventListener('touchmove', dismiss, { passive: true });
    addEventListener('keydown', onKey);
    intro.querySelector('[data-intro-skip]')!.addEventListener('click', dismiss);
    v.addEventListener('ended', dismiss);
    intro.querySelector<HTMLElement>('[data-intro-skip]')!.focus({ preventScroll: true });
  }
  initIntro();
  document.addEventListener('astro:page-load', initIntro);
  document.addEventListener('astro:page-load', initChapters);
</script>

<style>
  .project { display: grid; grid-template-columns: var(--split-case); gap: var(--s-3); align-items: start; }
  .project__left { position: sticky; top: var(--frame); height: calc(100vh - var(--frame) * 2); }
  .project__right { min-width: 0; }
  .chlayer { position: absolute; inset: 0; opacity: 0; transition: opacity 0.7s var(--ease-out); pointer-events: none; }
  .chlayer.is-on { opacity: 1; pointer-events: auto; }
  .project__left:not([data-chapters]) .chlayer { position: relative; height: 100%; opacity: 1; }
  /* the bar stays put while the content scrolls under it */
  .project__title { position: sticky; top: var(--frame); z-index: 6; padding: 0 0 8px; background: var(--chrome); box-shadow: 0 calc(var(--frame) * -1) 0 var(--chrome); }
  .project__blocks :global(.chap) { scroll-margin-top: 190px; }
  /* chapter dots on the left panel: where you are, and a way to jump */
  .dots { position: absolute; right: 18px; top: 18px; z-index: 4; display: flex; gap: 6px; }
  .dots__d { display: block; width: 12px; height: 4px; border-radius: 2px; background: rgba(212, 209, 203, 0.35); transition: width 500ms cubic-bezier(.22,.75,.25,1), background 400ms; position: relative; }
  .dots__d::before { content: ''; position: absolute; inset: -20px -4px; }
  .dots__d:hover { background: rgba(212, 209, 203, 0.7); }
  .dots__d.is-on { width: 32px; background: var(--acc); }
  .dots__d:focus-visible { outline: 2px solid var(--on-chrome); outline-offset: 3px; }
  .project__blocks { display: flex; flex-direction: column; gap: var(--s-2); }
  @media (max-width: 1199px) {
    .project { grid-template-columns: 1fr; }
    .project__left { position: relative; top: 0; height: min(72vh, 640px); }
    .project__title { top: 0; }
    .project__blocks :global(.chap) { scroll-margin-top: 150px; }
  }
  /* the intro film, full screen until you scroll */
  /* it fills the panel area, under the header (so you still see which case you're in) */
  .intro { position: fixed; top: var(--intro-top, 110px); left: var(--frame); right: var(--frame); bottom: var(--frame); z-index: 900; border-radius: var(--r-md); overflow: hidden; background: var(--acc); clip-path: inset(0 0 0 0 round var(--r-md)); transition: clip-path 750ms cubic-bezier(.65,0,.35,1), opacity 450ms ease; }
  .intro video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .intro.is-gone { opacity: 0; }
  .intro__bar { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 20px 24px; transition: opacity 300ms; }
  .intro.is-going .intro__bar { opacity: 0; }
  .intro__name { margin: 0; font-family: var(--font-serif); font-size: clamp(40px, 4vw, 72px); line-height: 0.9; letter-spacing: -0.03em; color: var(--paper); mix-blend-mode: difference; }
  .intro__name :global(em) { font-style: italic; }
  .intro__skip {
    all: unset; cursor: pointer; box-sizing: border-box; min-height: 44px; padding: 0 18px; border-radius: 22px; display: inline-flex; align-items: center; gap: 8px;
    background: var(--paper); color: #070707; font-family: var(--font-body); font-size: var(--fs-print);
  }
  .intro__skip:hover { background: #070707; color: var(--paper); }
  .intro__skip:focus-visible { outline: 2px solid var(--paper); outline-offset: 3px; }
  :global(html.intro-on) { overflow: hidden; }
</style>
