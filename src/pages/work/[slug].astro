---
/**
 * Work case · the company template (DESIGN.md, template 5). The text leads:
 * a title card with the facts, then four chapters (Context, Role, Process,
 * Result), each with its material underneath. The case wears its agent's
 * colour. Next case stays inside Work. Built only with the system.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/system/SiteHeader.astro';
import Panel from '../../components/system/Panel.astro';
import TitleCard from '../../components/system/TitleCard.astro';
import ChapterHeading from '../../components/system/ChapterHeading.astro';
import VideoBlock from '../../components/system/VideoBlock.astro';
import NextCase from '../../components/system/NextCase.astro';
import Label from '../../components/system/Label.astro';
import { existsSync } from 'node:fs';
import { getWork, projectUrl } from '../../lib/projects';
import { accentVars, rich } from '../../lib/utils';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((p, i) => ({ params: { slug: p.id }, props: { project: p, next: work[(i + 1) % work.length], index: i + 1, total: work.length } }));
}
const { project, next, index, total } = Astro.props;
const d = project.data;
const facts = [
  { label: 'Company', value: d.company || '' },
  { label: 'Years', value: (d.years || '').replace(/\s*[-–—]\s*/g, '–') },
  { label: 'Role', value: d.role || '' },
  { label: 'Via', value: d.via || '' },
].filter((f) => f.value);
const chapters = [
  { key: 'context', title: d.titles.context || 'Context', text: d.context },
  { key: 'role', title: d.titles.role || 'Role', text: d.roleText },
  { key: 'process', title: d.titles.process || 'Process', text: d.process },
  { key: 'result', title: d.titles.result || 'Result', text: d.result },
].filter((c) => c.text);
const webm = (src: string) => { const f = src.replace(/\.mp4$/, '.webm'); return src.endsWith('.mp4') && existsSync(`public${f}`) ? f : undefined; };
const mediaFor = (key: string) => d.media.filter((m) => m.chapter === key);
const top = mediaFor('top')[0];
const pad = (n: number) => String(n).padStart(2, '0');
// a [PLACEHOLDER] stays visible on purpose (CLAUDE.md), marked so nobody mistakes it for copy
const mark = (html: string) => html.replace(/\[PLACEHOLDER[^\]]*\]/g, (m) => `<mark class="ph">${m}</mark>`);
---
<Base title={d.title} description={d.lead || d.line || d.teaser} image={d.cover || top?.poster} nav={false}>
  <SiteHeader current={{ label: `Work ${pad(index)} / ${pad(total)}`, value: d.company || d.title }} />
  <Panel as="article" class="wc" label={d.title}>
    <div class="wc__grid" style={accentVars(d.accent)}>
      <aside class="wc__side">
        <TitleCard title={d.display || d.title} facts={facts} />
        <nav class="wc__toc" aria-label="Chapters">
          {chapters.map((c, i) => <a href={`#${c.key}`}><span class="wc__n">{pad(i + 1)}</span>{c.title}</a>)}
        </nav>
      </aside>
      <div class="wc__main">
        {top && <VideoBlock src={top.src} poster={top.poster} webm={webm(top.src)} width={top.width} height={top.height} alt={top.alt} />}
        {chapters.map((c, i) => (
          <section class="wc__ch" aria-labelledby={c.key}>
            <ChapterHeading n={i + 1} title={c.title} id={c.key} />
            <div class="wc__text" set:html={mark(rich(c.text))} />
            {mediaFor(c.key).length > 0 && (
              <div class="wc__media">
                {mediaFor(c.key).map((m) => <VideoBlock src={m.src} poster={m.poster} webm={webm(m.src)} width={m.width} height={m.height} alt={m.alt} caption={m.caption} />)}
              </div>
            )}
          </section>
        ))}
        {total > 1 && <NextCase href={projectUrl(next)} title={next.data.display || next.data.title} line={next.data.line || next.data.teaser} agent={next.data.accent} />}
      </div>
    </div>
  </Panel>
</Base>

<style>
  .wc__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--s-8); align-items: start; }
  .wc__side { position: sticky; top: var(--s-5); display: flex; flex-direction: column; gap: var(--s-5); }
  .wc__toc { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .wc__toc a {
    display: flex; gap: var(--s-3); align-items: baseline; padding: var(--s-2) 0; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none;
    font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-label); line-height: var(--lh-label); letter-spacing: var(--ls-label); text-transform: uppercase;
  }
  .wc__toc a:hover { background: var(--acc); color: var(--on-acc); }
  .wc__n { color: var(--muted); }
  .wc__toc a:hover .wc__n { color: var(--on-acc); }
  .wc__main { display: flex; flex-direction: column; gap: var(--s-8); min-width: 0; }
  .wc__ch { display: flex; flex-direction: column; gap: var(--s-5); scroll-margin-top: var(--s-5); }
  .wc__text { max-width: 64ch; font-family: var(--font-body); font-size: var(--fs-text); line-height: var(--lh-text); }
  .wc__text :global(p + p), .wc__text :global(p + ul), .wc__text :global(ul + p) { margin-top: var(--s-4); }
  .wc__text :global(ul) { margin: 0; padding-left: var(--s-5); display: flex; flex-direction: column; gap: var(--s-3); }
  .wc__media { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-4); }
  .wc__grid :global(.ph) { background: var(--paper-2); color: var(--red-text); font-family: var(--font-ui); font-size: var(--fs-label); letter-spacing: var(--ls-label); padding: 0 var(--s-1); border-radius: var(--r-sm); }

  @media (max-width: 1099px) {
    .wc__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .wc__side { position: static; }
  }
</style>
