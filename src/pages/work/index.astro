---
/**
 * Work index · carousel of featured projects on the left, intro and the
 * project cards on the right (2 × 2), explorations underneath.
 */
import Base from '../../layouts/Base.astro';
import Tab from '../../components/Tab.astro';
import Carousel from '../../components/Carousel.astro';
import { getEntry } from 'astro:content';
import { getProjects, projectUrl } from '../../lib/projects';
const w = (await getEntry('pages', 'work'))!.data;
const projects = await getProjects();
const client = projects.filter((p) => p.data.kind === 'client');
const explorations = projects.filter((p) => p.data.kind === 'exploration');
const label = (p: (typeof projects)[number]) => (p.id === 'cupra' ? 'seat | cupra' : p.data.title);
---
<Base title="work">
  <div class="wk">
    <div class="wk__left">
      <Carousel slides={w.slides || []} tab="overview projects" />
    </div>

    <div class="wk__right">
      <a class="intro" href="/about">
        <h1 class="intro__h">{w.title}</h1>
        <p class="intro__sub">{w.subtitle}</p>
        <p class="intro__p">{w.intro}</p>
      </a>

      <div class="grid">
        {client.map((p) => (
          <a href={projectUrl(p)} class="pcard">
            <img src={p.data.cover} alt="" loading="lazy" />
            <Tab corner="top-left"><span class="t-body">{label(p)}</span></Tab>
          </a>
        ))}
      </div>

      {explorations.length > 0 && (
        <>
          <section class="intro intro--ink">
            <h2 class="intro__h intro__h--s">{w.explorationsTitle}</h2>
            <p class="intro__p">{w.explorationsIntro}</p>
          </section>
          <div class="grid">
            {explorations.map((p) => (
              <a href={projectUrl(p)} class="pcard">
                <img src={p.data.cover} alt="" loading="lazy" />
                <Tab corner="top-left"><span class="t-body">{p.data.title}</span></Tab>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
</Base>

<style>
  .wk { display: grid; grid-template-columns: var(--split); gap: var(--s-3); align-items: start; }
  .wk__left { position: sticky; top: var(--frame); height: calc(100vh - var(--frame) * 2); }
  .wk__right { display: flex; flex-direction: column; gap: var(--s-3); }
  .intro { display: block; background: var(--paper); border-radius: var(--r-md); padding: 40px 40px 40px; min-height: 245px; }
  .intro__h { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-display); line-height: 36px; letter-spacing: 2px; }
  .intro__h--s { font-size: var(--fs-title); line-height: 1; letter-spacing: var(--ls-tab); }
  .intro__sub { margin-top: 2px; font-size: 18px; font-weight: 500; line-height: 18px; letter-spacing: var(--ls-tab); color: var(--muted-soft); }
  .intro__p { margin-top: 42px; font-size: var(--fs-body); line-height: var(--lh-body); letter-spacing: var(--ls-tab); max-width: 474px; }
  .intro--ink { background: var(--surface); color: var(--paper); min-height: 0; margin-top: 12px; }
  .intro--ink .intro__p { margin-top: 16px; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .pcard { position: relative; display: block; aspect-ratio: 271 / 362; border-radius: var(--r-md); overflow: hidden; background: var(--surface); }
  .pcard img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-slow) var(--ease-out); }
  .pcard:hover img { transform: scale(1.04); }
  @media (max-width: 1199px) {
    .wk { grid-template-columns: 1fr; }
    .wk__left { position: relative; top: 0; height: 420px; }
    .intro { padding: 32px; min-height: 280px; }
    .intro__p { margin-top: 48px; }
    .intro--ink { min-height: 0; }
    .pcard { aspect-ratio: 177 / 236; }
  }
</style>
