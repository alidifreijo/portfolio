---
/**
 * Work · index of the companies Ali has worked in. One row per company:
 * company, years, role, via, and one line. The row wears its agent colour
 * on hover. Built only with the system (DESIGN.md, template 3).
 */
import Base from '../../layouts/Base.astro';
import Panel from '../../components/system/Panel.astro';
import Label from '../../components/system/Label.astro';
import { getWork, projectUrl } from '../../lib/projects';
import { accentVars, emph } from '../../lib/utils';
const rows = (await getWork()).map((p) => ({
  href: projectUrl(p),
  company: p.data.company || p.data.title,
  years: (p.data.years || '').replace(/\s*[-–—]\s*/g, '–'),
  role: p.data.role || '',
  via: p.data.via || '',
  line: p.data.line || p.data.teaser || '',
  acc: accentVars(p.data.accent),
}));
const cols = ['Company', 'Years', 'Role', 'Via'];
---
<Base title="work" description="Teams Ali has designed with: the companies, her role and how she works.">
  <Panel label="Work">
   <div class="wk">
    <h1 class="type-section">Work</h1>
    <div class="wk__head" aria-hidden="true">{cols.map((c) => <Label>{c}</Label>)}<span></span></div>
    <ol class="wk__list">
      {rows.map((r) => (
        <li>
          <a class="wr" href={r.href} style={r.acc}>
            <span class="wr__c" set:html={emph(r.company)} />
            <dl class="wr__f">
              <div><dt>Years</dt><dd>{r.years}</dd></div>
              <div><dt>Role</dt><dd>{r.role}</dd></div>
              <div><dt>Via</dt><dd>{r.via}</dd></div>
            </dl>
            <span class="wr__l">{r.line}</span>
            <span class="wr__a" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
   </div>
  </Panel>
</Base>

<style>
  .wk { display: flex; flex-direction: column; gap: var(--s-6); min-height: calc(100vh - 210px); }
  .wk__head { padding-top: var(--s-2); }
  .wk__list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .wk__list li { border-top: 1px solid var(--line); padding: var(--s-1) 0; }
  .wk__head, .wr { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1.2fr) minmax(0, 2fr) minmax(0, 1.5fr) minmax(0, 4fr) 32px; gap: var(--s-4); align-items: baseline; }
  .wk__head { padding: 0 var(--s-3); margin-bottom: calc(var(--s-4) * -1); }
  .wr {
    padding: var(--s-5) var(--s-3); border-radius: var(--r-sm); color: var(--ink); text-decoration: none;
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }
  .wr__c { font-family: var(--font-serif); font-size: var(--fs-chapter); line-height: var(--lh-chapter); }
  .wr__c :global(em) { font-style: italic; }
  /* the facts sit in the grid's own columns on desktop */
  .wr__f { display: contents; margin: 0; }
  .wr__f div { display: contents; }
  .wr__f dt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .wr__f dd, .wr__l { margin: 0; font-family: var(--font-body); font-size: var(--fs-text); line-height: var(--lh-text); }
  .wr__l { color: var(--muted); }
  .wr__a { font-family: var(--font-ui); font-size: var(--fs-chapter); line-height: 1; justify-self: end; transition: transform var(--dur-base) var(--ease-out); }
  .wr:hover, .wr:focus-visible { background: var(--acc); color: var(--on-acc); }
  .wr:hover .wr__l, .wr:focus-visible .wr__l { color: var(--on-acc); }
  .wr:hover .wr__a { transform: translateX(4px); }

  @media (max-width: 1099px) {
    .wk__head { display: none; }
    .wr { grid-template-columns: minmax(0, 1fr) 32px; gap: var(--s-3); }
    .wr__c { grid-column: 1; }
    .wr__a { grid-column: 2; grid-row: 1; }
    .wr__f { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); grid-column: 1 / -1; }
    .wr__f div { display: flex; flex-direction: column; gap: var(--s-1); }
    .wr__f dt {
      position: static; width: auto; height: auto; overflow: visible; clip: auto;
      font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-label); line-height: var(--lh-label);
      letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--muted);
    }
    .wr:hover .wr__f dt, .wr:focus-visible .wr__f dt { color: var(--on-acc); }
    .wr__l { grid-column: 1 / -1; }
  }
</style>
