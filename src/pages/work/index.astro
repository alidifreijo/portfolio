---
/**
 * Work · v2, after Cartier's "Le Chœur des Pierres": every case is an
 * object (a cut-out) lying on one long diagonal, and scrolling pans along
 * it, like a camera travelling; nothing grows or blurs, things just pass by.
 * The one crossing the middle is the one you're on: its name is the title of
 * the scene, bottom left. Hovering it puts a flat, hand-drawn shape in its
 * colour behind it; clicking it grows that shape until it fills the screen
 * and the case opens out of it (into its intro film, if it has one).
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getProjects, projectUrl } from '../../lib/projects';
import { accentVars, rich } from '../../lib/utils';
import { BUBBLES } from '../../data/bubbles';
const projects = await getProjects();
const total = projects.length;
// the shapes behind the objects: the light "under" shapes of the home bubbles
const shapes = Object.values(BUBBLES).map((b) => b.under);
const items = projects.map((p, i) => ({
  n: String(i + 1).padStart(2, '0'),
  href: projectUrl(p),
  name: p.data.title,
  display: rich(p.data.display || p.data.title, false),
  type: p.data.meta.find((m: any) => m.label === 'Project' || m.label === 'Type')?.value || '',
  year: p.data.meta.find((m: any) => m.label === 'Year')?.value || '',
  img: p.data.object || p.data.cover,
  cut: !!p.data.object,
  acc: accentVars(p.data.accent),
  shape: shapes[i % shapes.length],
}));
---
<Base title="work" nav={false}>
  <div class="wr" data-wr style={`--n:${total}`}>
    <div class="ws">
      <SiteHeader />
      <section class="wp" aria-label="Selected work">
        <div class="wp__stage" data-stage>
          {items.map((it, i) => (
            <a href={it.href} class:list={['wo', { 'wo--card': !it.cut }]} data-wo={i} style={it.acc} aria-label={`${it.n} ${it.name}${it.type ? `, ${it.type}` : ''}${it.year ? ` ${it.year}` : ''}`}>
              <svg class="wo__shape" viewBox={`-2 -2 ${it.shape.w} ${it.shape.h}`} preserveAspectRatio="none" aria-hidden="true"><path d={it.shape.d} /></svg>
              <img class="wo__img" src={it.img} alt="" loading={i < 3 ? 'eager' : 'lazy'} draggable="false" />
            </a>
          ))}
        </div>

        <div class="wp__title" aria-live="polite">
          {items.map((it, i) => (
            <div class:list={['wt', { 'is-on': i === 0 }]} data-wt={i}>
              <p class="wt__n">Case {it.n} <span>/ {String(total).padStart(2, '0')}</span></p>
              <h2 class="wt__h" set:html={it.display} />
              <p class="wt__m">{it.type}{it.type && it.year && ' · '}{it.year}</p>
            </div>
          ))}
        </div>

        <nav class="wp__idx" aria-label="Jump to a case">
          {items.map((it, i) => (
            <button type="button" class:list={['wi', { 'is-on': i === 0 }]} data-wi={i}><span>{it.n}</span> {it.name}</button>
          ))}
        </nav>
        <p class="wp__hint" aria-hidden="true">Scroll to travel · click the one in the middle to step in</p>
      </section>
    </div>
  </div>
</Base>

<script>
  import { navigate } from 'astro:transitions/client';

  // Scroll moves a camera along the diagonal. Every object keeps its size;
  // they sit on two depths, so the far ones pass a little slower.
  function initWork() {
    const wr = document.querySelector<HTMLElement>('[data-wr]');
    if (!wr || wr.dataset.ready) return; wr.dataset.ready = '1';
    const objs = [...wr.querySelectorAll<HTMLAnchorElement>('[data-wo]')];
    const titles = [...wr.querySelectorAll<HTMLElement>('[data-wt]')];
    const idx = [...wr.querySelectorAll<HTMLButtonElement>('[data-wi]')];
    const n = objs.length;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pos = 0, target = 0, raf = 0, active = -1;
    const runway = () => wr.offsetHeight - innerHeight;
    const fromScroll = () => { const r = runway(); return r > 0 ? Math.min(1, Math.max(0, (scrollY - wr.offsetTop) / r)) * (n - 1) : 0; };
    const place = () => {
      const narrow = innerWidth < 810;
      const dx = narrow ? 78 : 42, dy = narrow ? 30 : 30; // vw / vh per case along the diagonal
      objs.forEach((o, i) => {
        const t = i - pos;
        const far = i % 2 ? 0.93 : 1;                       // two depths
        o.style.transform = `translate(calc(-50% + ${t * dx * far}vw), calc(-50% - ${t * dy * far}vh)) rotate(${(i % 2 ? 4 : -4)}deg)`;
        o.style.zIndex = String(i % 2 ? 10 : 20);
        // the ones already passed fade as they slide off under the title
        o.style.opacity = String(t < 0 ? Math.max(0, 1 + t * 1.4) : 1);
        o.tabIndex = Math.round(pos) === i ? 0 : -1;
      });
      const now = Math.round(pos);
      if (now !== active) {
        active = now;
        titles.forEach((t, i) => t.classList.toggle('is-on', i === active));
        idx.forEach((b, i) => { b.classList.toggle('is-on', i === active); b.toggleAttribute('aria-current', i === active); });
        objs.forEach((o, i) => o.classList.toggle('is-front', i === active));
      }
    };
    const loop = () => {
      raf = 0; if (!wr.isConnected) return;
      pos += (target - pos) * (reduce ? 1 : 0.1);
      if (Math.abs(target - pos) < 0.0005) pos = target;
      place();
      if (pos !== target) raf = requestAnimationFrame(loop);
    };
    const onScroll = () => { if (!wr.isConnected) { removeEventListener('scroll', onScroll); return; } target = fromScroll(); if (!raf) raf = requestAnimationFrame(loop); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    const go = (i: number) => scrollTo({ top: wr.offsetTop + (runway() * i) / (n - 1), behavior: reduce ? 'auto' : 'smooth' });
    idx.forEach((b, i) => b.addEventListener('click', () => go(i)));
    objs.forEach((o, i) => {
      o.addEventListener('focus', () => { if (i !== active) go(i); });
      o.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        if (i !== active) { go(i); return; } // one on the way: bring it to the middle first
        enter(o);
      });
    });
    target = pos = fromScroll(); place();
  }

  // Step in: the flat shape behind the object grows until it fills the
  // screen, crisp edges, no blur. It lives on <html>, outside <body>, so it
  // stays while the case loads; the case clears it (see work/[slug].astro).
  function enter(o: HTMLAnchorElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { navigate(o.href); return; }
    const color = getComputedStyle(o).getPropertyValue('--acc').trim() || '#D4D1CB';
    const shape = o.querySelector('.wo__shape')!.cloneNode(true) as SVGElement;
    shape.removeAttribute('class'); [...shape.attributes].forEach((a) => a.name.startsWith('data-astro') && shape.removeAttribute(a.name));
    const r = o.getBoundingClientRect();
    const ink = document.createElement('div');
    ink.className = 'ink'; ink.setAttribute('aria-hidden', 'true');
    ink.style.setProperty('--c', color);
    ink.style.setProperty('--x', `${r.left + r.width / 2}px`);
    ink.style.setProperty('--y', `${r.top + r.height / 2}px`);
    ink.style.setProperty('--w', `${r.width * 1.1}px`);
    ink.append(shape);
    document.documentElement.append(ink);
    requestAnimationFrame(() => requestAnimationFrame(() => ink.classList.add('is-in')));
    setTimeout(() => navigate(o.href), 760);
  }

  initWork();
  document.addEventListener('astro:page-load', initWork);
</script>

<style>
  /* a scroll runway: the screen stays while you travel along the cases */
  .wr { height: calc(100svh - var(--frame) * 2 + (var(--n) - 1) * 60svh); }
  .ws { position: sticky; top: var(--frame); height: calc(100svh - var(--frame) * 2); display: flex; flex-direction: column; }
  .wp { position: relative; flex: 1; min-height: 0; background: var(--paper); border-radius: var(--r-md); overflow: hidden; color: #070707; }
  .wp__stage { position: absolute; inset: 0; }

  /* the objects: cut-outs, no frame */
  .wo { position: absolute; left: 50%; top: 47%; width: clamp(240px, 26vw, 480px); height: min(40vh, 420px); display: grid; place-items: center; will-change: transform; outline: none; }
  .wo__img { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: contain; user-select: none; filter: drop-shadow(0 22px 26px rgba(7, 7, 7, 0.22)); transition: scale 500ms cubic-bezier(.3,1.4,.5,1); }
  .wo--card .wo__img { border-radius: 10px; object-fit: cover; }
  .wo.is-front { cursor: pointer; }
  .wo.is-front:hover .wo__img, .wo.is-front:focus-visible .wo__img { scale: 1.04; }
  .wo:focus-visible .wo__img { outline: 2px solid #070707; outline-offset: 8px; }
  /* the flat shape in the case colour, on hover */
  .wo__shape { position: absolute; left: 50%; top: 50%; width: 118%; height: 92%; translate: -50% -46%; fill: var(--acc); overflow: visible; scale: 0.2; opacity: 0; rotate: -4deg; transition: scale 550ms cubic-bezier(.3,1.35,.5,1), opacity 200ms; }
  .wo.is-front:hover .wo__shape, .wo.is-front:focus-visible .wo__shape { scale: 1; opacity: 1; }

  /* the title of the scene, bottom left */
  .wp__title { position: absolute; left: 28px; bottom: 26px; z-index: 40; pointer-events: none; display: grid; }
  .wt { grid-area: 1 / 1; opacity: 0; translate: 0 14px; transition: opacity 350ms var(--ease-out), translate 550ms cubic-bezier(.22,.75,.25,1); }
  .wt.is-on { opacity: 1; translate: 0 0; transition-delay: 100ms; }
  .wt__n, .wt__m { margin: 0; font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.45; }
  .wt__n span, .wt__m { color: #57534d; }
  .wt__h { margin: 4px 0 6px; font-family: var(--font-serif); font-weight: 400; font-size: clamp(60px, 7.4vw, 150px); line-height: 0.85; letter-spacing: -0.035em; }
  .wt__h :global(strong) { font-weight: 400; font-style: italic; }

  .wp__idx { position: absolute; right: 24px; bottom: 24px; z-index: 40; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .wi { all: unset; cursor: pointer; min-height: 28px; display: inline-flex; align-items: baseline; gap: 8px; font-family: var(--font-body); font-size: var(--fs-print); color: #070707; opacity: 0.4; transition: opacity 300ms; }
  .wi span { font-size: 0.85em; }
  .wi:hover, .wi:focus-visible, .wi.is-on { opacity: 1; }
  .wi.is-on::before { content: '→'; }
  .wi:focus-visible { outline: 2px solid #070707; outline-offset: 3px; }
  .wp__hint { position: absolute; left: 28px; top: 22px; margin: 0; z-index: 40; font-family: var(--font-body); font-size: var(--fs-print); color: #57534d; }

  @media (max-width: 809px) {
    .wo { width: 66vw; height: 36vh; }
    .wt__h { font-size: 52px; }
    .wp__idx, .wp__hint { display: none; }
    .wp__title { left: 16px; bottom: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .wt, .wo__shape, .wo__img { transition: none; } }
</style>
