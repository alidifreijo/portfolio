---
/**
 * Contact · v2, same frame as the home: the header and one paper panel.
 * The crossword takes the panel ("let's play"). In the corner, a face:
 * click it and it chats with you, handing over the contact details.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Crossword from '../components/Crossword.astro';
import { getEntry } from 'astro:content';
import { rich } from '../lib/utils';
const c = (await getEntry('pages', 'contact'))!.data as any;
const split = (t: string) => { const i = t.lastIndexOf(' '); return i > 0 ? [t.slice(0, i), t.slice(i + 1)] : ['', t]; };
const [p1, p2] = split(c.playTitle);
const chat: string[] = (c.chat || []).map((l: string) => rich(l, false));
// quick replies: what you ask, and what the face answers
const replies = [
  ...c.links.map((l: any) => {
    const mail = l.url.startsWith('mailto:');
    const shown = mail ? l.url.replace('mailto:', '') : l.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
    const ask = mail ? 'Can I email you?' : l.icon === 'film' ? 'What are you watching?' : `Your ${l.label}?`;
    const say = mail ? 'Always. Write to me at' : l.icon === 'film' ? 'My film diary, judge away:' : 'Here you go:';
    return { ask, say, href: l.url, shown, ext: !mail, download: false };
  }),
  { ask: 'Can I see your CV?', say: 'Of course:', href: c.cv, shown: 'Download the CV (PDF)', ext: false, download: true },
];
---
<Base title="contact" nav={false}>
  <div class="ctp">
    <SiteHeader />
    <section class="ct3" aria-labelledby="play-h">
      <header class="ct3__head">
        <h1 class="ct3__h" id="play-h">{p1} <em>{p2}</em>.</h1>
        <button class="ct3__btn" type="button" onclick="document.dispatchEvent(new Event('crossword:resolve'))">Resolve</button>
      </header>
      <div class="ct3__cw"><Crossword clues={c.clues} /></div>

      <!-- the talking head -->
      <div class="talk" data-talk>
        <div class="talk__card" id="talk-card" role="dialog" aria-label={c.talkTitle} hidden>
          <div class="talk__top">
            <p class="talk__who">Ali <span>· usually around</span></p>
            <button class="talk__x" type="button" data-talk-close aria-label="Close the chat">×</button>
          </div>
          <div class="talk__log" data-talk-log aria-live="polite"></div>
          <div class="talk__chips" data-talk-chips></div>
        </div>
        <button class="talk__face" type="button" data-talk-open aria-expanded="false" aria-controls="talk-card">
          <img class="talk__line" src="/images/faces/bucket-hat.png" alt="" width="110" height="137" />
          <img class="talk__color" src="/images/faces/color/open/bucket-hat.png" alt="" width="110" height="137" loading="lazy" />
          <span class="talk__note">{c.talkTitle}?</span>
          <span class="sr-only">Open a chat with my contact details</span>
        </button>
      </div>
      <script is:inline type="application/json" data-talk-data set:html={JSON.stringify({ chat, replies })} />
    </section>
  </div>
</Base>

<script>
  // The head fakes a chat: it types its first lines, then offers quick
  // replies; each one gets its answer with the link.
  function initTalk() {
    const root = document.querySelector<HTMLElement>('[data-talk]');
    if (!root || root.dataset.ready) return; root.dataset.ready = '1';
    const data = JSON.parse(document.querySelector('[data-talk-data]')!.textContent || '{}');
    const card = root.querySelector<HTMLElement>('.talk__card')!;
    const log = root.querySelector<HTMLElement>('[data-talk-log]')!;
    const chips = root.querySelector<HTMLElement>('[data-talk-chips]')!;
    const face = root.querySelector<HTMLButtonElement>('[data-talk-open]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let started = false, busy = false;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));
    const bubble = (html: string, who: 'me' | 'you') => {
      const b = document.createElement('p'); b.className = `talk__b talk__b--${who}`; b.innerHTML = html;
      log.append(b); log.scrollTop = log.scrollHeight; return b;
    };
    const say = async (html: string) => {
      const t = bubble('<span class="talk__dots"><i></i><i></i><i></i></span>', 'me'); t.setAttribute('aria-hidden', 'true');
      await wait(Math.min(1400, 450 + html.replace(/<[^>]+>/g, '').length * 12));
      t.removeAttribute('aria-hidden'); t.innerHTML = html; log.scrollTop = log.scrollHeight;
      await wait(250);
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[m]);
    const offer = () => {
      chips.innerHTML = '';
      data.replies.forEach((r: any, i: number) => {
        if (r.used) return;
        const b = document.createElement('button'); b.type = 'button'; b.className = 'talk__chip'; b.textContent = r.ask;
        b.addEventListener('click', async () => {
          if (busy) return; busy = true; r.used = true; chips.innerHTML = '';
          bubble(esc(r.ask), 'you');
          const link = `<a href="${esc(r.href)}"${r.ext ? ' target="_blank" rel="noopener"' : ''}${r.download ? ' download' : ''}>${esc(r.shown)}</a>`;
          await wait(300); await say(`${esc(r.say)} ${link}`);
          if (data.replies.every((x: any) => x.used)) await say('That’s everything. Talk soon!');
          busy = false; offer();
        });
        chips.append(b);
      });
    };
    const open = async () => {
      card.hidden = false; root.classList.add('is-open'); face.setAttribute('aria-expanded', 'true');
      if (started) { offer(); return; }
      started = true; busy = true;
      for (const l of data.chat) await say(l);
      busy = false; offer();
      (chips.querySelector('button') as HTMLElement | null)?.focus({ preventScroll: true });
    };
    const close = () => { card.hidden = true; root.classList.remove('is-open'); face.setAttribute('aria-expanded', 'false'); face.focus({ preventScroll: true }); };
    face.addEventListener('click', () => (card.hidden ? open() : close()));
    root.querySelector('[data-talk-close]')!.addEventListener('click', close);
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !card.hidden) close(); });
  }
  initTalk();
  document.addEventListener('astro:page-load', initTalk);
</script>

<style>
  .ctp { min-height: calc(100svh - var(--frame) * 2); display: flex; flex-direction: column; }
  .ct3 {
    position: relative; flex: 1; min-height: 600px; background: var(--paper); color: #070707; border-radius: var(--r-md);
    padding: 28px 28px 32px; box-sizing: border-box; display: flex; flex-direction: column; gap: 28px;
  }
  .ct3__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .ct3__h { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: clamp(56px, 6vw, 112px); line-height: 0.85; letter-spacing: -0.035em; }
  .ct3__h em { font-style: italic; }
  .ct3__btn {
    all: unset; cursor: pointer; min-height: 44px; padding: 0 20px; border-radius: 22px; border: 1px solid #070707; box-sizing: border-box; display: inline-flex; align-items: center;
    font-family: var(--font-body); font-size: var(--fs-print); color: #070707; transition: background 200ms, color 200ms;
  }
  .ct3__btn:hover, .ct3__btn:focus-visible { background: #070707; color: var(--paper); }
  .ct3__btn:focus-visible { outline: 2px solid #070707; outline-offset: 3px; }

  /* the crossword, horizontal: the grid big on the left, the clues on the right */
  .ct3__cw { flex: 1; display: flex; }
  .ct3__cw :global(.cw) { flex: 1; flex-direction: row; align-items: center; gap: clamp(28px, 4vw, 72px); }
  .ct3__cw :global(.cw__grid) { --cell: min(calc(58cqw / var(--cols)), 62px); flex: none; }
  .ct3__cw :global(.cw__foot) { flex: 1; min-width: 0; padding-right: 150px; }
  .ct3__cw :global(.cw__clues) { columns: 2 220px; }
  .ct3__cw :global(.cw__clues li) { font-size: clamp(15px, 1.05vw, 17px); }

  /* the talking head, bottom right */
  .talk { position: absolute; right: 22px; bottom: 18px; z-index: 5; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .talk__face { all: unset; cursor: pointer; position: relative; width: clamp(92px, 8vw, 120px); aspect-ratio: 110 / 137; transition: rotate 450ms cubic-bezier(.3,1.6,.5,1), scale 450ms cubic-bezier(.3,1.6,.5,1); }
  .talk__face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity 250ms var(--ease-out); }
  .talk__color { opacity: 0; }
  .talk__face:hover, .talk__face:focus-visible { rotate: -6deg; scale: 1.06; }
  .talk__face:hover .talk__color, .talk__face:focus-visible .talk__color, .talk.is-open .talk__color { opacity: 1; }
  .talk__face:hover .talk__line, .talk__face:focus-visible .talk__line, .talk.is-open .talk__line { opacity: 0; }
  .talk__face:focus-visible { outline: 2px solid #070707; outline-offset: 6px; border-radius: 50%; }
  .talk__note { position: absolute; right: 88%; top: 2%; white-space: nowrap; rotate: -8deg; font-family: var(--font-hand); font-size: clamp(22px, 1.6vw, 28px); color: #070707; transition: opacity 250ms; }
  .talk.is-open .talk__note { opacity: 0; }
  .talk__face { animation: talk-nudge 6s ease-in-out 2.5s infinite; transform-origin: 50% 90%; }
  .talk.is-open .talk__face { animation: none; }
  @keyframes talk-nudge { 0%, 88%, 100% { translate: 0 0; } 91% { translate: 0 -8px; } 94% { translate: 0 0; } 96% { translate: 0 -4px; } }

  .talk__card {
    width: min(380px, calc(100vw - 48px)); max-height: min(520px, 62vh); display: flex; flex-direction: column;
    background: #070707; color: var(--on-chrome); border-radius: 16px; box-shadow: 0 24px 60px rgba(7, 7, 7, 0.3); overflow: hidden;
    transform-origin: 100% 100%; animation: talk-in 380ms cubic-bezier(.3,1.25,.5,1) both;
  }
  .talk__card[hidden] { display: none; }
  @keyframes talk-in { from { opacity: 0; scale: 0.85; translate: 0 12px; } to { opacity: 1; scale: 1; translate: 0 0; } }
  .talk__top { display: flex; justify-content: space-between; align-items: center; padding: 12px 12px 10px 18px; border-bottom: 1px solid #2a2926; }
  .talk__who { margin: 0; font-family: var(--font-body); font-size: var(--fs-print); }
  .talk__who span { color: var(--muted-ink); }
  .talk__x { all: unset; cursor: pointer; width: 44px; height: 44px; display: grid; place-items: center; font-size: 22px; border-radius: 50%; }
  .talk__x:hover, .talk__x:focus-visible { background: #1d1c1a; }
  .talk__log { flex: 1; overflow-y: auto; padding: 16px 16px 8px; display: flex; flex-direction: column; gap: 8px; }
  .talk__log :global(.talk__b) {
    margin: 0; max-width: 85%; padding: 10px 14px; border-radius: 16px; font-family: var(--font-body); font-size: clamp(14px, 1vw, 16px); line-height: 1.45;
    animation: talk-b 320ms var(--ease-out) both;
  }
  .talk__log :global(.talk__b--me) { align-self: flex-start; background: #98E7EB; color: #0b3a3d; border-bottom-left-radius: 4px; }
  .talk__log :global(.talk__b--you) { align-self: flex-end; background: #2a2926; color: var(--on-chrome); border-bottom-right-radius: 4px; }
  .talk__log :global(.talk__b strong) { font-weight: 600; }
  .talk__log :global(.talk__b a) { color: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; overflow-wrap: anywhere; }
  .talk__log :global(.talk__dots) { display: inline-flex; gap: 4px; padding: 4px 0; }
  .talk__log :global(.talk__dots i) { width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: 0.4; animation: talk-dot 1s infinite; }
  .talk__log :global(.talk__dots i:nth-child(2)) { animation-delay: 0.15s; }
  .talk__log :global(.talk__dots i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes talk-dot { 30% { opacity: 1; translate: 0 -3px; } }
  @keyframes talk-b { from { opacity: 0; translate: 0 6px; } to { opacity: 1; translate: 0 0; } }
  .talk__chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 16px 16px; }
  .talk__chips:empty { display: none; }
  .talk__chips :global(.talk__chip) {
    all: unset; cursor: pointer; box-sizing: border-box; min-height: 40px; padding: 8px 14px; border-radius: 20px; border: 1px solid #98E7EB; color: #98E7EB;
    font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.3; transition: background 200ms, color 200ms;
  }
  .talk__chips :global(.talk__chip:hover), .talk__chips :global(.talk__chip:focus-visible) { background: #98E7EB; color: #070707; }
  .talk__chips :global(.talk__chip:focus-visible) { outline: 2px solid #98E7EB; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .talk__face, .talk__card, .talk__log :global(*) { animation: none !important; } }

  @media (max-width: 1099px) {
    .ct3__cw :global(.cw) { flex-direction: column; align-items: stretch; }
    .ct3__cw :global(.cw__grid) { --cell: min(calc(100cqw / var(--cols)), 52px); }
    .ct3__cw :global(.cw__foot) { padding-right: 0; padding-bottom: 130px; }
  }
  @media (max-width: 809px) {
    .ct3 { padding: 20px 16px 24px; }
    .ct3__head { flex-wrap: wrap; align-items: center; }
    .talk { position: fixed; right: 16px; bottom: 16px; }
  }
</style>
