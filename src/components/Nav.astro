---
/**
 * Nav · the main menu, fixed in the top-left corner of the frame.
 * Each link turns on hover like a drum (as in the Framer original): the word
 * tips back and away while an identical copy turns up from below.
 */
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/about', label: 'about' },
  { href: '/work', label: 'work' },
  { href: '/contact', label: 'contact' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<nav class="nav" aria-label="Main" transition:name="nav">
  <div class="nav__tab">
    <a href="/" class="nav__logo" aria-label="Home">á</a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class="nav__link" aria-current={isCurrent(l.href) ? 'page' : undefined}>
            <span class="nav__roll" aria-hidden="true"><span>{l.label}</span><span class="i">{l.label}</span></span>
            <span class="sr-only">{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <svg class="nav__c nav__c--r" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 0 H16 A16 16 0 0 0 0 16 Z" /></svg>
    <svg class="nav__c nav__c--b" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 0 H16 A16 16 0 0 0 0 16 Z" /></svg>
  </div>
</nav>

<style>
  .nav { position: fixed; top: var(--frame); left: var(--frame); z-index: 50; }
  .nav__tab {
    position: relative;
    display: flex; align-items: center; gap: 36px; height: 42px;
    background: var(--chrome); color: var(--on-chrome);
    padding: 0 12px 0 16px;
    border-bottom-right-radius: 20px;
  }
  .nav__c { position: absolute; width: var(--tab-corner); height: var(--tab-corner); fill: var(--chrome); }
  .nav__c--r { top: 0; right: calc(var(--tab-corner) * -1); }
  .nav__c--b { left: 0; bottom: calc(var(--tab-corner) * -1); }
  .nav__logo { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-title); line-height: 0.8; margin-top: -2px; }
  ul { display: flex; gap: 36px; list-style: none; margin: 0; padding: 0; }
  .nav__link { font-family: var(--font-display); font-size: var(--fs-label); line-height: 1.2; letter-spacing: 0; display: block; position: relative; }
  .nav__roll { display: block; position: relative; height: 1.2em; perspective: 120px; }
  .nav__roll span {
    display: block; backface-visibility: hidden; transform-origin: 50% 50% -0.6em;
    transition: transform 420ms var(--ease-out), opacity 420ms var(--ease-out);
  }
  .nav__roll .i { position: absolute; inset: 0; transform: rotateX(-90deg); opacity: 0; }
  .nav__link:hover .nav__roll span:first-child { transform: rotateX(90deg); opacity: 0; }
  .nav__link:hover .nav__roll .i { transform: rotateX(0); opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .nav__roll span { transition: none; } }
</style>
