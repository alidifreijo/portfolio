---
/**
 * Faces · the six self-portraits on the home page.
 * Hover (or tap) a face: it fills with colour, grows with a spring and
 * says something about how I work in a hand-drawn bubble, exactly as in the
 * Framer original. Positions are % of the panel. Bubble drawings live in
 * src/data/bubbles.ts; the quote is here, **bold** works.
 */
import { BUBBLES } from '../data/bubbles';

// line drawings: '' = original black, 'taupe/' = lines in #A19887 (UI test)
const LINE = '';

const faces = [
  // x / y / w: desktop centre and width (% of the panel) · mx / my / mw: mobile · ar: proportions
  { id: 'bucket-hat', alt: 'Bucket hat', x: 39.8, y: 31.6, w: 7.77, mx: 22.1, my: 39.0, mw: 30.05, ar: '110/137', o: '135% 139%', g: { W: 110.4, dark: [66.4, 120.6], light: [75.8, 113.6], text: [75.4, 133.6, 197] }, quote: '“**Creative mess,** but beautifully organized.”' },
  { id: 'messy-hair', alt: 'Messy hair', x: 60.1, y: 25.7, w: 10.95, mx: 24.0, my: 64.8, mw: 30.6, ar: '155/157', g: { W: 154.9, dark: [91.9, 106.3], light: [106.9, 105.2], text: [118.9, 128.3, 154] }, quote: '“**Teamwork** is my coping mechanism.”' },
  { id: 'cap', alt: 'Cap', x: 75.9, y: 48.9, w: 11.37, mx: 80.1, my: 39.6, mw: 32.24, ar: '161/164', g: { W: 160.9, dark: [96.9, 142.2], light: [101.6, 147.6], text: [108.9, 165.2, 138] }, quote: '“**Research** is my love language.”' },
  { id: 'long-hair', alt: 'Long hair', x: 65.4, y: 72.6, w: 11.37, mx: 78.1, my: 73.0, mw: 32.24, ar: '161/164', g: { W: 160.9, dark: [-81, 152.3], light: [-77, 157.3], text: [-85, 174.3, 162] }, quote: '“**Chaos?** not on my watch.”' },
  { id: 'sprout', alt: 'Sprout', x: 42.0, y: 77.2, w: 12.08, mx: 68.0, my: 60.0, mw: 34.97, ar: '171/174', g: { W: 170.9, dark: [93, 142.1], light: [110, 141.4], text: [111, 162.1, 173] }, quote: '“**Empathetic**, caffeinated, slightly existential.”' },
  { id: 'bob', alt: 'Bob', x: 25.5, y: 56.4, w: 8.62, mx: 50.1, my: 29.5, mw: 21.58, ar: '122/124', g: { W: 121.9, dark: [-118, 137.3], light: [-117.6, 141.8], text: [-117, 160.3, 162] }, quote: '“I find peace in **naming layers.**”' },
];

const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');

// g: bubble geometry measured on the original at 1440px, in px relative to
// the face's top-left corner (W = face width there). Converted to % of the
// face width, so bubbles keep the same proportion at any size.
const items = faces.map((f, i) => {
  const b = BUBBLES[f.id];
  const u = (px: number) => `${((px / f.g.W) * 100).toFixed(2)}cqw`;
  const pos = {
    dark: `left:${u(f.g.dark[0])};top:${u(f.g.dark[1])};width:${u(b.shape.w)};height:${u(b.shape.h)}`,
    light: `left:${u(f.g.light[0])};top:${u(f.g.light[1])};width:${u(b.under.w)};height:${u(b.under.h)}`,
    text: `left:${u(f.g.text[0])};top:${u(f.g.text[1])};width:${u(f.g.text[2])};font-size:${u(14)}`,
  };
  return { ...f, i, b, pos };
});
---
<div class="faces" data-faces>
  {items.map((f) => (
    <button
      class="face"
      style={`--x:${f.x}%;--y:${f.y}%;--w:${f.w}%;--mx:${f.mx}%;--my:${f.my}%;--mw:${f.mw}%;--ar:${f.ar};--o:${(f as any).o || '50% 50%'};--ink:${f.b.ink};--light:${f.b.light}`}
      aria-label={`${f.alt}: ${f.quote.replace(/\*\*/g, '')}`}
    >
      <span class="face__img">
        <img class="face__line" src={`/images/faces/${LINE}${f.id}.png`} alt="" draggable="false" />
        <img class="face__color" src={`/images/faces/color/${f.id}.png`} alt="" draggable="false" loading="lazy" />
      </span>
      <span class="bubble" aria-hidden="true">
        <svg class="bubble__under" style={f.pos.light} viewBox={`-2 -2 ${f.b.under.w} ${f.b.under.h}`}><path d={f.b.under.d} /></svg>
        <svg class="bubble__shape" style={f.pos.dark} viewBox={`-2 -2 ${f.b.shape.w} ${f.b.shape.h}`}><path d={f.b.shape.d} /></svg>
        <span class="bubble__text" style={f.pos.text} set:html={bold(f.quote)} />
      </span>
    </button>
  ))}
</div>

<script>
  function initFaces() {
  // Mouse: hover shows the bubble. Touch: tap toggles it (tap outside closes).
  // Every face can be dragged, as in the Framer original: it follows the
  // pointer, keeps its colour while held, glides a little when released and
  // stays where it lands, inside the panel.
  document.querySelectorAll<HTMLElement>('[data-faces]').forEach((root) => {
    if (root.dataset.ready) return; root.dataset.ready = '1';
    let z = 10;
    const faces = [...root.querySelectorAll<HTMLButtonElement>('.face')];
    const on = (b: HTMLElement) => { faces.forEach((o) => o !== b && o.classList.remove('is-on')); b.classList.add('is-on'); b.style.zIndex = String(++z); };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    faces.forEach((b) => {
      let dx = 0, dy = 0, sx = 0, sy = 0, ox = 0, oy = 0, moved = false, held = false, raf = 0;
      let vx = 0, vy = 0, lt = 0, lx = 0, ly = 0;
      const set = () => { b.style.setProperty('--dx', dx + 'px'); b.style.setProperty('--dy', dy + 'px'); };
      // keep the face's centre inside the panel
      const clamp = () => {
        const r = root.getBoundingClientRect(), f = b.getBoundingClientRect();
        const cx = f.left + f.width / 2, cy = f.top + f.height / 2;
        const pad = Math.max(f.width, f.height) * 0.5 + 8;
        if (cx < r.left + pad) dx += r.left + pad - cx; if (cx > r.right - pad) dx -= cx - (r.right - pad);
        if (cy < r.top + pad) dy += r.top + pad - cy; if (cy > r.bottom - pad) dy -= cy - (r.bottom - pad);
      };
      b.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        cancelAnimationFrame(raf);
        held = true; moved = false; sx = e.clientX; sy = e.clientY; ox = dx; oy = dy;
        lx = e.clientX; ly = e.clientY; lt = e.timeStamp; vx = vy = 0;
        b.setPointerCapture(e.pointerId);
      });
      b.addEventListener('pointermove', (e) => {
        if (!held) return;
        const mx = e.clientX - sx, my = e.clientY - sy;
        if (!moved && Math.hypot(mx, my) < 4) return;
        if (!moved) { moved = true; on(b); b.classList.add('is-drag'); }
        dx = ox + mx; dy = oy + my; set();
        const dt = Math.max(1, e.timeStamp - lt);
        vx = (e.clientX - lx) / dt; vy = (e.clientY - ly) / dt; lx = e.clientX; ly = e.clientY; lt = e.timeStamp;
      });
      const release = (e: PointerEvent) => {
        if (!held) return; held = false;
        if (!moved) return;
        b.classList.remove('is-drag');
        // a short glide with friction, then settle inside the panel
        let px = reduce ? 0 : vx * 16, py = reduce ? 0 : vy * 16;
        const step = () => {
          px *= 0.9; py *= 0.9; dx += px; dy += py; clamp(); set();
          if (Math.hypot(px, py) > 0.3) raf = requestAnimationFrame(step);
        };
        step();
        const over = document.elementFromPoint(e.clientX, e.clientY)?.closest('.face') === b;
        if (e.pointerType === 'mouse' && !over) b.classList.remove('is-on');
      };
      b.addEventListener('pointerup', release);
      b.addEventListener('pointercancel', release);
      b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') on(b); });
      b.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !held) b.classList.remove('is-on'); });
      b.addEventListener('click', (e) => {
        if (moved) { e.preventDefault(); moved = false; return; }
        if ((e as PointerEvent).pointerType === 'mouse') return;
        b.classList.contains('is-on') ? b.classList.remove('is-on') : on(b);
      });
      b.addEventListener('focus', () => on(b));
      b.addEventListener('blur', () => b.classList.remove('is-on'));
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.face')) faces.forEach((o) => o.classList.remove('is-on'));
    });
  });
  }
  initFaces();
  document.addEventListener('astro:page-load', initFaces);
</script>

<style>
  .faces { position: absolute; inset: 0; }
  .face {
    all: unset; cursor: pointer; position: absolute; left: var(--x); top: var(--y);
    width: var(--w); aspect-ratio: var(--ar); translate: -50% -50%;
    container-type: inline-size;
    transform: translate(var(--dx, 0px), var(--dy, 0px));
    touch-action: none; user-select: none; -webkit-user-select: none;
  }
  .face.is-drag { cursor: grabbing; }
  /* Hover, as in the original: the face swaps to colour at once and grows
     to ~1.18× with a slow spring (overshoot, settles in ~2s). */
  .face__img {
    position: absolute; inset: 0; display: block;
    transform-origin: var(--o);
    transition: scale 450ms cubic-bezier(0.25, 0.8, 0.3, 1);
  }
  .face__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .face__color { opacity: 0; }

  /* Bubble: appears instantly, at its own size, light shape under the dark one. */
  .bubble { position: absolute; inset: 0; pointer-events: none; visibility: hidden; }
  .bubble svg { position: absolute; overflow: visible; }
  .bubble__under { fill: var(--light); }
  .bubble__shape { fill: var(--ink); }
  .bubble__text {
    position: absolute; text-align: center; color: var(--light);
    font-family: var(--font-display); font-weight: 400; line-height: 1.2; letter-spacing: 0.05em;
  }
  .bubble__text :global(b) { font-weight: 700; }

  .face.is-on .face__img {
    scale: 1.18;
    transition: scale 2000ms linear(0, 0.23 12.5%, 0.66 25%, 1 37.5%, 1.17 50%, 1.18 62.5%, 1.12 75%, 1.05 87.5%, 1);
  }
  .face.is-on .face__line { opacity: 0; }
  .face.is-on .face__color { opacity: 1; }
  .face.is-on .bubble { visibility: visible; }
  .face:focus-visible { outline: 2px solid var(--brand); outline-offset: 6px; border-radius: 50%; }

  @media (prefers-reduced-motion: reduce) {
    .face__img, .face.is-on .face__img { transition: none; }
  }
  @media (max-width: 809px) {
    .face { width: var(--mw); left: var(--mx); top: var(--my); }
  }
</style>
