---
/**
 * Faces · the six self-portraits on the home page.
 * Hover (or tap) a face: it fills with colour and says something about
 * how I work in a hand-drawn bubble. Clicking keeps it raised until another
 * one is picked. Positions are % of the panel. Bubbles live in
 * src/data/bubbles.ts; the quote is here, **bold** works.
 */
import { BUBBLES } from '../data/bubbles';

const faces = [
  // x / y: desktop position · mx / my: mobile position
  { id: 'bucket-hat', alt: 'Bucket hat', x: 40, y: 31, mx: 28, my: 20, quote: '“**Creative mess,** but beautifully organized.”' },
  { id: 'messy-hair', alt: 'Messy hair', x: 60, y: 25, mx: 70, my: 16, quote: '“**Teamwork** is my coping mechanism.”' },
  { id: 'cap', alt: 'Cap', x: 75, y: 49, mx: 76, my: 36, quote: '“**Research** is my love language.”' },
  { id: 'long-hair', alt: 'Long hair', x: 65, y: 73, mx: 70, my: 80, quote: '“**Chaos?** not on my watch.”' },
  { id: 'sprout', alt: 'Sprout', x: 42, y: 76, mx: 30, my: 84, quote: '“**Empathetic**, caffeinated, slightly existential.”' },
  { id: 'bob', alt: 'Bob', x: 26, y: 57, mx: 24, my: 64, quote: '“I find peace in **naming layers.**”' },
];

const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');

const items = faces.map((f, i) => {
  const b = BUBBLES[f.id];
  // The bubble opens away from its tail on desktop, and towards the centre
  // of the screen on mobile. If that fights the tail, the drawing is mirrored.
  const openD = b.tail === 'left' ? 'right' : 'left';
  const openM = f.mx > 50 ? 'left' : 'right';
  const flip = (open: string) => ((open === 'left') === (b.tail === 'left') ? -1 : 1);
  return { ...f, i, b, openD, openM, flipD: flip(openD), flipM: flip(openM) };
});
---
<div class="faces" data-faces>
  {items.map((f) => (
    <button
      class="face"
      style={`--x:${f.x}%;--y:${f.y}%;--mx:${f.mx}%;--my:${f.my}%;--d:${f.i * 0.7}s;--ink:${f.b.ink};--light:${f.b.light};--bw:${f.b.shape.w};--bh:${f.b.shape.h};--flip-d:${f.flipD};--flip-m:${f.flipM}`}
      data-open-d={f.openD}
      data-open-m={f.openM}
      aria-label={`${f.alt}: ${f.quote.replace(/\*\*/g, '')}`}
    >
      <span class="face__img">
        <img class="face__line" src={`/images/faces/${f.id}.png`} alt="" draggable="false" />
        <img class="face__color" src={`/images/faces/color/${f.id}.png`} alt="" draggable="false" loading="lazy" />
      </span>
      <span class="bubble" aria-hidden="true">
        <span class="bubble__art">
          <svg class="bubble__under" viewBox={`-2 -2 ${f.b.under.w} ${f.b.under.h}`} preserveAspectRatio="none"><path d={f.b.under.d} /></svg>
          <svg class="bubble__shape" viewBox={`-2 -2 ${f.b.shape.w} ${f.b.shape.h}`} preserveAspectRatio="none"><path d={f.b.shape.d} /></svg>
        </span>
        <span class="bubble__text"><span set:html={bold(f.quote)} /></span>
      </span>
    </button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-faces]').forEach((root) => {
    let z = 10;
    const faces = root.querySelectorAll<HTMLButtonElement>('.face');
    const raise = (b: HTMLElement) => { b.style.zIndex = String(++z); };
    faces.forEach((b) => {
      b.addEventListener('pointerenter', () => raise(b));
      b.addEventListener('click', () => {
        faces.forEach((o) => o !== b && o.classList.remove('is-up'));
        b.classList.toggle('is-up');
        raise(b);
      });
    });
    // Tap outside closes the open bubble.
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.face')) faces.forEach((o) => o.classList.remove('is-up'));
    });
  });
</script>

<style>
  .faces { position: absolute; inset: 0; }
  .face {
    all: unset; cursor: pointer; position: absolute; left: var(--x); top: var(--y);
    width: clamp(84px, 9vw, 128px); aspect-ratio: 1; translate: -50% -50%;
    animation: float 6s var(--ease-in-out) var(--d) infinite alternate;
    --open: var(--open-d); --flip: var(--flip-d);
  }
  .face__img {
    position: absolute; inset: 0; display: block;
    transition: scale var(--dur-base) var(--ease-in-out), rotate var(--dur-base) var(--ease-in-out);
  }
  .face__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .face__line { mix-blend-mode: multiply; transition: opacity var(--dur-fast) var(--ease-out); }
  .face__color { opacity: 0; transition: opacity var(--dur-fast) var(--ease-out); }

  /* The bubble: dark drawn shape with its tail, light shape peeking under it. */
  .bubble {
    position: absolute; top: 64%; width: calc(var(--bw) * 0.92px); aspect-ratio: var(--bw) / var(--bh);
    pointer-events: none; opacity: 0; scale: 0.6; rotate: -6deg;
    transform-origin: 0 0;
    transition: opacity var(--dur-fast) var(--ease-out), scale var(--dur-base) var(--ease-out), rotate var(--dur-base) var(--ease-out);
  }
  .face[data-open-d='right'] .bubble { left: 52%; }
  .face[data-open-d='left'] .bubble { right: 52%; transform-origin: 100% 0; rotate: 6deg; }
  .bubble__art { position: absolute; inset: 0; scale: var(--flip) 1; }
  .bubble__art svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .bubble__under { fill: var(--light); translate: 2% 10%; }
  .bubble__shape { fill: var(--ink); }
  .bubble__text {
    position: absolute; inset: 22% 11% 14% 11%; display: flex; align-items: center; justify-content: center;
    text-align: center; color: var(--light); font: 400 13px/1.25 var(--font-display);
    letter-spacing: 0.01em; text-wrap: balance;
  }
  .bubble__text :global(b) { font-weight: 700; }

  @media (hover: hover) {
    .face:hover .face__img { scale: 1.08; }
    .face:hover .face__line { opacity: 0; }
    .face:hover .face__color { opacity: 1; }
    .face:hover .bubble { opacity: 1; scale: 1; rotate: 0deg; }
  }
  .face.is-up .face__img { scale: 1.14; rotate: -3deg; }
  .face.is-up .face__line { opacity: 0; }
  .face.is-up .face__color { opacity: 1; }
  .face.is-up .bubble { opacity: 1; scale: 1; rotate: 0deg; }
  .face.is-up { animation-play-state: paused; }
  .face:focus-visible { outline: 2px solid var(--brand); outline-offset: 6px; border-radius: 50%; }
  .face:focus-visible .face__color { opacity: 1; }
  .face:focus-visible .bubble { opacity: 1; scale: 1; rotate: 0deg; }

  @keyframes float { from { transform: translateY(-4px); } to { transform: translateY(4px); } }
  @media (prefers-reduced-motion: reduce) {
    .face { animation: none; }
    .bubble { transition: opacity var(--dur-fast) linear; scale: 1; rotate: 0deg; }
  }
  @media (max-width: 760px) {
    .face { width: 84px; left: var(--mx); top: var(--my); --flip: var(--flip-m); }
    .bubble { width: calc(var(--bw) * 0.78px); top: 74%; }
    .bubble__text { font-size: 11.5px; }
    .face[data-open-m='right'] .bubble { left: 40%; right: auto; transform-origin: 0 0; }
    .face[data-open-m='left'] .bubble { right: 40%; left: auto; transform-origin: 100% 0; }
  }
</style>
