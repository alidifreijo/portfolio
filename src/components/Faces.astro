---
/**
 * Faces · the six self-portraits on the home page.
 * Hover (or tap) a face: it fills with colour, grows with a spring and
 * says something about how I work in a hand-drawn bubble, exactly as in the
 * Framer original. Positions and hover geometry measured on it. Bubble drawings live in
 * src/data/bubbles.ts; the quote is here, **bold** works.
 * Each face is also a link: `to` is the case that proves what the bubble says
 * (matched by colour: the face's colour is the project's accent).
 *
 * `proof` names it for screen readers; on screen it's a small arrow on the bubble.
 */
import { BUBBLES } from '../data/bubbles';

// Each drawing is split in two: the face with empty glasses (open/) and the
// lenses alone (eyes/), so the lenses can follow the cursor.

const faces = [
  // x / y / w: centre and width in % of the faces box, measured on the Framer original · mx / my / mw: mobile box · ar: proportions
  { id: 'bucket-hat', alt: 'Bucket hat', to: 'contact', proof: 'contact', x: 31.25, y: 14.62, w: 13.0, mx: 22, my: 34, mw: 30.0, ar: '110/137', g: {S: 1.18, o: '136% 138%', under: [84.75, -6.5, 84.59, 9.3, 162.7, 70.3], shape: [84.75, -14.4, 84.59, 15.2, 173.7, 50.8], text: [84.75, -6.8, 84.59, 26.3, 167.0, 28.5]}, quote: '“**Creative mess,** but beautifully organized.”' },
  { id: 'messy-hair', alt: 'Messy hair', to: 'work/cut-scenes', proof: 'cut scenes', x: 65.11, y: 3.5, w: 18.2, mx: 24, my: 72, mw: 28.7, ar: '155/157', g: {S: 1.175, o: '50% 44%', under: [92.02, -40.1, 90.79, -42.6, 149.0, 80.0], shape: [92.02, -52.8, 90.79, -41.7, 164.3, 65.6], text: [92.02, -29.8, 90.79, -23.0, 131.1, 28.6]}, quote: '“**Teamwork** is my coping mechanism.”' },
  { id: 'cap', alt: 'Cap', to: 'work/cupra', proof: 'cupra', x: 91.41, y: 48.02, w: 18.82, mx: 80, my: 35, mw: 28.6, ar: '161/164', g: {S: 1.178, o: '50% 46%', under: [86.84, -41.3, 85.51, -3.4, 129.9, 60.3], shape: [86.84, -45.3, 85.51, -8.0, 137.5, 57.7], text: [86.84, -35.1, 85.51, 11.5, 117.1, 28.5]}, quote: '“**Research** is my love language.”' },
  { id: 'long-hair', alt: 'Long hair', to: 'work/hmi', proof: 'hmi display', x: 73.92, y: 93.66, w: 18.82, mx: 78, my: 84, mw: 28.6, ar: '161/164', g: {S: 1.178, o: '50% 46%', under: [13.15, -74.3, 85.52, 4.7, 124.8, 56.9], shape: [13.15, -77.7, 85.52, 0.5, 137.5, 57.7], text: [13.15, -64.35, 85.52, 19.0, 104.0, 28.5]}, quote: '“**Chaos?** not on my watch.”' },
  { id: 'sprout', alt: 'Sprout', to: 'work/bank-platform', proof: 'bank platform', x: 35.01, y: 102.07, w: 19.85, mx: 68, my: 63, mw: 28.6, ar: '171/174', g: {S: 1.197, o: '50% 83%', under: [86.88, -42.6, 85.36, -6.6, 147.0, 83.5], shape: [86.88, -56.8, 85.36, -6.0, 166.2, 70.2], text: [86.88, -41.8, 85.36, 10.7, 144.5, 42.1]}, quote: '“**Empathetic**, caffeinated, slightly existential.”' },
  { id: 'bob', alt: 'Bob', to: 'work/fintech', proof: 'fintech app', x: 7.56, y: 62.7, w: 14.8, mx: 50, my: 21, mw: 28.6, ar: '122/124', g: {S: 1.234, o: '52% 21%', under: [-6.38, -75.6, 106.67, -12.1, 128.0, 60.8], shape: [-6.38, -75.8, 106.67, -15.8, 138.6, 55.1], text: [-6.38, -75.0, 106.67, 2.8, 131.3, 27.2]}, quote: '“I find peace in **naming layers.**”' },
];

const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');

// g: measured on the Framer original at 1440 and 1920px.
//   S: hover scale · o: transform-origin of the hover.
//   under / shape / text: [x% of the face, x px, y% of the face, y px, width px, height px],
//   in the face's own (unscaled) box, so after the hover scale they land
//   exactly where Framer puts them. Bubbles keep a fixed size (14px text).
const items = faces.map((f, i) => {
  const b = BUBBLES[f.id];
  const g = f.g as any;
  const at = (v: number[]) => `left:calc(${v[0]}% + ${v[1]}px);top:calc(${v[2]}% + ${v[3]}px);width:${v[4]}px`;
  const pos = {
    light: `${at(g.under)};height:${g.under[5]}px`,
    dark: `${at(g.shape)};height:${g.shape[5]}px`,
    go: `left:calc(${g.shape[0]}% + ${(g.shape[1] + g.shape[4] - 30 / g.S).toFixed(1)}px);top:calc(${g.shape[2]}% + ${(g.shape[3] + g.shape[5] - 14 / g.S).toFixed(1)}px);width:${(26 / g.S).toFixed(1)}px`,
    text: `${at([g.text[0], g.text[1] - 3, g.text[2], g.text[3], g.text[4] + 6])};font-size:${(14 / g.S).toFixed(2)}px;letter-spacing:${(0.7 / g.S).toFixed(3)}px`,
  };
  return { ...f, i, b, pos };
});
---
<div class="faces" data-faces>
  <div class="faces__box">
  {items.map((f) => (
    <a
      href={`/${(f as any).to}`}
      data-id={f.id}
      class="face"
      style={`--x:${f.x}%;--y:${f.y}%;--w:${f.w}%;--mx:${f.mx}%;--my:${f.my}%;--mw:${f.mw}%;--ar:${f.ar};--o:${(f.g as any).o};--s:${(f.g as any).S};--ink:${f.b.ink};--light:${f.b.light}`}
      aria-label={`${f.quote.replace(/\*\*/g, '')} See ${(f as any).proof}.`}
      draggable="false"
    >
      <span class="face__img">
        <img class="face__line" src={`/images/faces/open/${f.id}.png`} alt="" draggable="false" />
        <img class="face__line face__eyes" src={`/images/faces/eyes/${f.id}.png`} alt="" draggable="false" />
        <img class="face__color" src={`/images/faces/color/open/${f.id}.png`} alt="" draggable="false" loading="lazy" />
        <img class="face__color face__eyes" src={`/images/faces/color/eyes/${f.id}.png`} alt="" draggable="false" loading="lazy" />
      <span class="bubble" aria-hidden="true">
        <svg class="bubble__under" style={f.pos.light} viewBox={`-2 -2 ${f.b.under.w} ${f.b.under.h}`}><path d={f.b.under.d} /></svg>
        <svg class="bubble__shape" style={f.pos.dark} viewBox={`-2 -2 ${f.b.shape.w} ${f.b.shape.h}`}><path d={f.b.shape.d} /></svg>
        <span class="bubble__text" style={f.pos.text} set:html={bold(f.quote)} />
        <span class="bubble__go" style={f.pos.go}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg></span>
      </span>
      </span>
    </a>
  ))}
  </div>
  <button class="faces__tidy" type="button">tidy up ↺</button>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  // A face opens its case with the normal page transition (the painted
  // transitions are parked for later; see git history, commit "three.js").
  const go = (face: HTMLAnchorElement) => {
    const href = face.getAttribute('href')!;
    document.querySelector('[name="astro-view-transitions-enabled"]') ? navigate(href) : (location.href = face.href);
  };

  function initFaces() {
  // Mouse: hover shows the bubble. Touch: tap toggles it (tap outside closes).
  // Every face can be dragged, as in the Framer original: it follows the
  // pointer, keeps its colour while held, glides a little when released and
  // stays where it lands, inside the panel.
  document.querySelectorAll<HTMLElement>('[data-faces]').forEach((root) => {
    if (root.dataset.ready) return; root.dataset.ready = '1';
    let z = 10;
    // the nod plays once, a moment after the page appears
    [...root.querySelectorAll<HTMLElement>('.face')].forEach((f, i) => f.style.setProperty('--d', `${i * 90}ms`));
    // pop-in order and timing measured on Framer (ms after the panel starts opening)
    const POP: Record<string, number> = { 'messy-hair': 450, cap: 550, 'long-hair': 600, 'bucket-hat': 700, sprout: 850, bob: 1000 };
    root.querySelectorAll<HTMLElement>('.face').forEach((f) => f.style.setProperty('--pop', `${POP[f.dataset.id || ''] ?? 600}ms`));
    // Entry, copied from the Framer original: the panel opens from half its
    // size out of the dark, then the faces pop in one by one. Plays on the
    // first visit and every time the á is pressed on the home page. After a
    // while without anyone touching the page, the faces nod.
    let hintT = 0, idleT = 0;
    const panel = root.closest<HTMLElement>('.home');
    const enter = () => {
      if (!panel || matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.remove('pre-enter'); return; }
      root.querySelectorAll('.face').forEach((f) => f.classList.remove('is-on'));
      panel.classList.remove('is-entering'); void panel.offsetWidth; panel.classList.add('is-entering');
      document.documentElement.classList.remove('pre-enter');
      setTimeout(() => panel.classList.remove('is-entering'), 1900);
    };
    const nod = () => {
      if (root.querySelector('.face.is-on, .face.is-drag')) return;
      root.classList.remove('is-hint'); void root.offsetWidth; root.classList.add('is-hint');
      clearTimeout(hintT); hintT = window.setTimeout(() => root.classList.remove('is-hint'), 2600);
    };
    const idle = () => { clearTimeout(idleT); idleT = window.setTimeout(() => { nod(); idle(); }, 12000); };
    if (!(window as any).__entered) { (window as any).__entered = true; enter(); }
    idle();
    root.addEventListener('pointerdown', () => { root.classList.remove('is-hint'); idle(); });
    root.addEventListener('pointermove', idle, { passive: true });
    const logo = document.querySelector<HTMLAnchorElement>('.nav__logo');
    logo?.addEventListener('click', (e) => { if (root.isConnected) { e.preventDefault(); enter(); idle(); } });

    // Mess up the faces and a "tidy up" appears; it sends them home and the
    // long-haired one has the last word.
    const tidyBtn = root.querySelector<HTMLButtonElement>('.faces__tidy')!;
    function mess() {
      const offs = faces.map((f) => (f as any)._off?.() || 0);
      const messy = offs.filter((o) => o > 60).length >= 2 || offs.some((o) => o > 180);
      root.classList.toggle('is-messy', messy);
    }
    tidyBtn.addEventListener('click', () => {
      root.classList.remove('is-messy'); root.classList.add('is-tidy');
      faces.forEach((f) => { f.classList.remove('is-on'); (f as any)._home?.(); });
      const chaos = faces.find((f) => f.getAttribute('href')?.includes('/hmi')) || faces[3];
      setTimeout(() => { root.classList.remove('is-tidy'); on(chaos); setTimeout(() => { if (!chaos.matches(':hover')) chaos.classList.remove('is-on'); }, 2600); }, 1000);
    });
    // Eyes: the lenses look at the cursor.
    let er = 0, px = -1, py = -1;
    const look = () => {
      er = 0;
      faces.forEach((f) => {
        const r = f.getBoundingClientRect();
        if (px < 0) { f.style.setProperty('--ex', '0'); f.style.setProperty('--ey', '0'); return; }
        const vx = px - (r.left + r.width * 0.5), vy = py - (r.top + r.height * 0.55);
        const d = Math.hypot(vx, vy) || 1, m = Math.min(1, d / 260);
        f.style.setProperty('--ex', ((vx / d) * m).toFixed(3)); f.style.setProperty('--ey', ((vy / d) * m).toFixed(3));
      });
    };
    const onMove = (e: PointerEvent) => {
      if (!root.isConnected) { removeEventListener('pointermove', onMove); return; }
      px = e.clientX; py = e.clientY; if (!er) er = requestAnimationFrame(look);
    };
    addEventListener('pointermove', onMove, { passive: true });
    document.documentElement.addEventListener('mouseleave', () => { px = py = -1; look(); });

    const faces = [...root.querySelectorAll<HTMLAnchorElement>('.face')];
    // keep the bubble on screen: predict where it lands after the hover
    // scale and nudge it back inside the panel if it would spill over
    const fit = (b: HTMLElement) => {
      const img = b.querySelector<HTMLElement>('.face__img')!, bub = b.querySelector<HTMLElement>('.bubble')!;
      bub.style.translate = '';
      const r = root.getBoundingClientRect(), ir = img.getBoundingClientRect();
      const cs = getComputedStyle(b), S = parseFloat(cs.getPropertyValue('--s')) || 1.2;
      const [oxs, oys] = cs.getPropertyValue('--o').trim().split(/\s+/);
      const ox = ir.left + ir.width * parseFloat(oxs) / 100;
      let L = Infinity, R = -Infinity;
      bub.querySelectorAll('svg, .bubble__go').forEach((el) => { const e = el.getBoundingClientRect(); L = Math.min(L, ox + (e.left - ox) * S); R = Math.max(R, ox + (e.right - ox) * S); });
      const pad = 10; let dx = 0;
      if (R > r.right - pad) dx = r.right - pad - R; else if (L < r.left + pad) dx = r.left + pad - L;
      if (dx) bub.style.translate = `${dx / S}px 0`;
    };
    const on = (b: HTMLElement) => { faces.forEach((o) => o !== b && o.classList.remove('is-on')); fit(b); b.classList.add('is-on'); b.style.zIndex = String(++z); };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    faces.forEach((b) => {
      let dx = 0, dy = 0, sx = 0, sy = 0, ox = 0, oy = 0, moved = false, held = false, raf = 0;
      let vx = 0, vy = 0, lt = 0, lx = 0, ly = 0, kind = 'mouse', wasOn = false;
      const set = () => { b.style.setProperty('--dx', dx + 'px'); b.style.setProperty('--dy', dy + 'px'); };
      (b as any)._off = () => Math.hypot(dx, dy);
      (b as any)._home = () => { cancelAnimationFrame(raf); dx = 0; dy = 0; set(); };
      // keep the face's centre inside the panel
      const clamp = () => {
        const r = root.getBoundingClientRect(), f = b.getBoundingClientRect();
        const cx = f.left + f.width / 2, cy = f.top + f.height / 2;
        const pad = Math.max(f.width, f.height) * 0.5 + 8;
        if (cx < r.left + pad) dx += r.left + pad - cx; if (cx > r.right - pad) dx -= cx - (r.right - pad);
        if (cy < r.top + pad) dy += r.top + pad - cy; if (cy > r.bottom - pad) dy -= cy - (r.bottom - pad);
      };
      b.addEventListener('pointerdown', (e) => {
        kind = e.pointerType; wasOn = b.classList.contains('is-on');
        if (e.button !== 0) return;
        cancelAnimationFrame(raf);
        held = true; moved = false; sx = e.clientX; sy = e.clientY; ox = dx; oy = dy;
        lx = e.clientX; ly = e.clientY; lt = e.timeStamp; vx = vy = 0;
        b.setPointerCapture(e.pointerId);
      });
      b.addEventListener('pointermove', (e) => {
        if (!held) return;
        const mx = e.clientX - sx, my = e.clientY - sy;
        if (!moved && Math.hypot(mx, my) < 4) return;
        if (!moved) { moved = true; on(b); b.classList.add('is-drag'); }
        dx = ox + mx; dy = oy + my; set();
        const dt = Math.max(1, e.timeStamp - lt);
        vx = (e.clientX - lx) / dt; vy = (e.clientY - ly) / dt; lx = e.clientX; ly = e.clientY; lt = e.timeStamp;
      });
      const release = (e: PointerEvent) => {
        if (!held) return; held = false;
        if (!moved) return;
        b.classList.remove('is-drag');
        // a short glide with friction, then settle inside the panel
        let px = reduce ? 0 : vx * 16, py = reduce ? 0 : vy * 16;
        const step = () => {
          px *= 0.9; py *= 0.9; dx += px; dy += py; clamp(); set();
          if (Math.hypot(px, py) > 0.3) raf = requestAnimationFrame(step);
        };
        step();
        setTimeout(mess, 500);
        const over = document.elementFromPoint(e.clientX, e.clientY)?.closest('.face') === b;
        if (e.pointerType === 'mouse' && !over) b.classList.remove('is-on');
      };
      b.addEventListener('pointerup', release);
      b.addEventListener('pointercancel', release);
      b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') on(b); });
      b.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && !held ) b.classList.remove('is-on'); });
      // mouse: a click opens the case. Touch: the first tap shows the bubble,
      // the second one opens the case. A drag never navigates.
      b.addEventListener('click', (e) => {
        if (moved) { e.preventDefault(); moved = false; return; }
        if (kind !== 'mouse' && !wasOn && e.detail !== 0) { e.preventDefault(); on(b); return; }
        e.preventDefault(); go(b);
      });
      b.addEventListener('focus', () => on(b));
      b.addEventListener('blur', () => b.classList.remove('is-on'));
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.face')) faces.forEach((o) => o.classList.remove('is-on'));
    });
  });
  }
  initFaces();
  document.addEventListener('astro:page-load', initFaces);
</script>

<style>
  .faces { position: absolute; inset: 0; z-index: 2; pointer-events: none; --spring-face: linear(0, 0.069, 0.243, 0.468, 0.702, 0.912, 1.076, 1.185, 1.24, 1.248, 1.221, 1.173, 1.115, 1.057, 1.008, 0.971, 0.948, 0.938, 0.939, 0.948, 0.961, 0.976, 0.99, 1.001, 1.009, 1.014, 1.016, 1.015, 1.012, 1.009, 1.005, 1.002, 0.999, 0.997, 0.996, 0.996, 0.997, 0.997, 0.998, 0.999, 1); }
  /* Same box as in Framer: 60% of the panel (max 1200px), 1.866:1, centred. */
  .faces__box { position: absolute; width: 60%; max-width: 1200px; aspect-ratio: 1.866; top: 50%; left: 51%; translate: -50% -50%; }
  .face {
    all: unset; cursor: grab; position: absolute; left: var(--x); top: var(--y);
    width: var(--w); aspect-ratio: var(--ar); translate: -50% -50%;
    container-type: inline-size;
    transform: translate(var(--dx, 0px), var(--dy, 0px));
    touch-action: none; user-select: none; -webkit-user-select: none; pointer-events: auto;
  }
  .face.is-drag { cursor: grabbing; }
  /* First visit: the faces nod one after another, so people know they're alive. */
  .faces.is-hint .face__img { animation: nod 900ms var(--d, 0ms) both; }
  @keyframes nod {
    0%, 100% { rotate: 0deg; translate: 0 0; }
    20% { rotate: -7deg; translate: 0 -6%; }
    45% { rotate: 5deg; translate: 0 0; }
    70% { rotate: -2deg; }
  }
  /* a small arrow on the bubble's corner: the face opens its case */
  .bubble__go {
    position: absolute; aspect-ratio: 1; border-radius: 50%; background: var(--light); color: var(--ink);
    display: grid; place-items: center; box-shadow: 0 0 0 1.5px var(--ink);
  }
  .bubble__go svg { width: 58%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  /* Hover, measured on the Framer original: the face swaps to colour at once
     and grows to 1.18× on a quick spring (about 25% overshoot of the move,
     peak at ~0.22s, settled by ~0.8s). Leaving uses the same spring back. */
  .face__img {
    position: absolute; inset: 0; display: block;
    transform-origin: var(--o);
    transition: scale 1000ms linear(0, 0.069, 0.243, 0.468, 0.702, 0.912, 1.076, 1.185, 1.24, 1.248, 1.221, 1.173, 1.115, 1.057, 1.008, 0.971, 0.948, 0.938, 0.939, 0.948, 0.961, 0.976, 0.99, 1.001, 1.009, 1.014, 1.016, 1.015, 1.012, 1.009, 1.005, 1.002, 0.999, 0.997, 0.996, 0.996, 0.997, 0.997, 0.998, 0.999, 1);
  }
  .face__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .face__color { opacity: 0; }
  /* the lenses look towards the cursor, a few px inside the frames */
  .face__img .face__eyes { translate: calc(var(--ex, 0) * 1.7cqw) calc(var(--ey, 0) * 1.1cqw); transition: translate 160ms ease-out; }
  .faces__tidy {
    all: unset; position: absolute; right: 18px; bottom: 18px; z-index: 3; pointer-events: auto; cursor: pointer;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.02em; color: var(--paper); background: var(--ink);
    padding: 8px 14px; border-radius: 999px; opacity: 0; translate: 0 8px; visibility: hidden;
    transition: opacity 240ms var(--ease-out), translate 240ms var(--ease-out), visibility 0s 240ms;
  }
  .faces.is-messy .faces__tidy { opacity: 1; translate: 0 0; visibility: visible; transition-delay: 0s; }
  .faces__tidy:hover { background: #2a2a2a; }
  .faces__tidy:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  /* tidy up: everyone goes home on the same spring as the hover */
  /* entry (first visit and á): panel opens out of the dark, faces pop in */
  :global(html.pre-enter .home) { transform: scale(0.5); filter: brightness(0.08); }
  :global(html.pre-enter) .face__img { opacity: 0; }
  :global(.home.is-entering) { animation: panel-in 620ms cubic-bezier(0.3, 0, 0.2, 1) both; }
  @keyframes panel-in { from { transform: scale(0.5); filter: brightness(0.08); } }
  :global(.home.is-entering) .face__img { animation: face-pop 700ms var(--spring-face) var(--pop, 600ms) both; }
  @keyframes face-pop { from { scale: 0.75; opacity: 0; } 30% { opacity: 1; } to { scale: 1; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { :global(.home.is-entering), :global(.home.is-entering) .face__img { animation: none; } }
  .faces.is-tidy .face { transition: transform 1100ms linear(0, 0.069, 0.243, 0.468, 0.702, 0.912, 1.076, 1.185, 1.24, 1.248, 1.221, 1.173, 1.115, 1.057, 1.008, 0.971, 0.948, 0.938, 0.939, 0.948, 0.961, 0.976, 0.99, 1.001, 1.009, 1.014, 1.016, 1.015, 1.012, 1.009, 1.005, 1.002, 0.999, 0.997, 0.996, 0.996, 0.997, 0.997, 0.998, 0.999, 1); }

  /* Bubble: appears instantly, at its own size, light shape under the dark one. */
  .bubble { position: absolute; inset: 0; pointer-events: none; visibility: hidden; }
  .bubble svg { position: absolute; overflow: visible; }
  .bubble__under { fill: var(--light); }
  .bubble__shape { fill: var(--ink); }
  .bubble__text {
    position: absolute; text-align: center; color: var(--light);
    font-family: var(--font-display); font-weight: 400; line-height: 1.2; letter-spacing: 0.05em;
  }
