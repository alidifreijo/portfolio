---
/**
 * Button · links that look like buttons.
 *  primary    ink pill
 *  secondary  outline pill
 *  ghost      text link with underline
 *  tile       full-width row with an icon at the end (contact links)
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'tile';
  external?: boolean;
  download?: boolean;
  icon?: 'arrow' | 'download' | 'linkedin' | 'mail' | 'film' | 'none';
  class?: string;
}
const { href, variant = 'primary', external = false, download = false, icon = variant === 'tile' ? 'arrow' : 'none', class: cls = '' } = Astro.props;
const ext = external || /^https?:/.test(href);
const icons: Record<string, string> = {
  arrow: '<path d="M5 11 L11 5 M6 5 H11 V10" />',
  download: '<path d="M8 3 V10 M5 7.5 L8 10.5 L11 7.5 M4 13 H12" />',
  linkedin: '<rect x="3" y="3" width="10" height="10" rx="1.5"/><path d="M5.5 7 V11 M5.5 5.3 V5.4 M7.8 11 V8.5 C7.8 7.5 8.5 7 9.2 7 C10 7 10.5 7.5 10.5 8.5 V11 M7.8 7 V11"/>',
  mail: '<rect x="2.5" y="4" width="11" height="8" rx="1.2"/><path d="M3 5 L8 9 L13 5"/>',
  film: '<rect x="3" y="3" width="10" height="10" rx="1.5"/><path d="M6 3 V13 M10 3 V13 M3 6 H6 M10 6 H13 M3 10 H6 M10 10 H13"/>',
};
---
<a
  href={href}
  class:list={['btn', `btn--${variant}`, 'press', cls]}
  target={ext ? '_blank' : undefined}
  rel={ext ? 'noopener' : undefined}
  download={download || undefined}
>
  <span><slot /></span>
  {icon !== 'none' && (
    <svg class="btn__i" viewBox="0 0 16 16" aria-hidden="true" set:html={icons[icon]} />
  )}
</a>

<style>
  .btn { display: inline-flex; align-items: center; gap: var(--s-2); font-family: var(--font-body); font-size: var(--fs-small); font-weight: 500; line-height: 1; transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .btn__i { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; flex: none; }
  .btn--primary { background: var(--ink); color: var(--paper); border-radius: var(--r-pill); padding: 9px var(--s-4); }
  .btn--primary:hover { background: var(--brand); }
  .btn--secondary { border: 1px solid currentColor; border-radius: var(--r-pill); padding: 8px var(--s-4); }
  .btn--secondary:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn--ghost { padding: 0; text-decoration: underline; text-underline-offset: 3px; }
  .btn--ghost:hover { text-decoration-thickness: 2px; }
  .btn--tile {
    width: 100%; justify-content: space-between; font-size: var(--fs-body);
    background: var(--acc, var(--paper)); color: var(--on-acc, var(--ink));
    border-radius: var(--r-lg); padding: var(--s-5) var(--s-4); min-height: 64px;
  }
  .btn--tile:hover { background: var(--ink); color: var(--acc, var(--paper)); }
  .btn--tile .btn__i { transition: transform var(--dur-base) var(--ease-out); }
  .btn--tile:hover .btn__i { transform: translate(2px, -2px); }
</style>
