---
/**
 * KitSouth · the South component kit, live. Nine components built in
 * code so they can be used, not just watched: press the button, switch
 * the segmented control, type in the input, pick an option, add people
 * to the group… Each card shows the component's tokens underneath.
 * Used by the `kit` block with `kit: south`.
 */
import SouthMark from './SouthMark.astro';
---
<div class="kit" data-kit="south">
  <p class="kit__intro t-small">Six components from the South kit, built in code. They play once, then they are yours: click, type, switch.</p>
  <div class="kit__grid">
    <div class="kc" data-c="segmented">
      <span class="kc__name">Segmented control</span><span class="kc__desc">Period picker on the balance chart</span>
      <div class="s-seg" data-seg>
        <i class="s-seg__thumb"></i>
        <button type="button" class="is-on">Monthly</button><button type="button">Trimester</button><button type="button">Semester</button><button type="button">Year</button>
      </div>
      <span class="kc__props"><b>thumb</b> moss + 1.5 mint · <b>spring</b> 320ms</span>
    </div>

    <div class="kc" data-c="option">
      <span class="kc__name">Option card</span><span class="kc__desc">Choose what to automate</span>
      <div class="s-opts" data-opts>
        <button type="button" class="s-opt is-on"><b>Payroll</b><span>Salary automation for your employees.</span></button>
        <button type="button" class="s-opt"><b>Taxes</b><span>Automates the payment of state taxes.</span></button>
      </div>
      <span class="kc__props"><b>selected</b> ring 2 mint · <b>radius</b> 6</span>
    </div>

    <div class="kc" data-c="group">
      <span class="kc__name">Group</span><span class="kc__desc">Pay a team as one recipient</span>
      <div class="s-grp">
        <div><b>Employees</b><small>Atelier</small></div>
        <div class="s-grp__n"><button type="button" aria-label="Remove one" data-dec>−</button><b data-count>5</b><button type="button" aria-label="Add one" data-inc>+</button><small>Total people</small></div>
      </div>
      <span class="kc__props"><b>counter</b> tabular nums · <b>max</b> 10</span>
    </div>

    <div class="kc" data-c="input">
      <span class="kc__name">Input</span><span class="kc__desc">Validates as you type</span>
      <label class="s-inp"><span class="sr-only">Email</span><input type="email" placeholder="david@atelier.com" autocomplete="off" spellcheck="false" /><i class="s-inp__ok" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg></i></label>
      <span class="kc__props"><b>focus</b> 1.5 mint · <b>valid</b> check</span>
    </div>

    <div class="kc" data-c="tabbar">
      <span class="kc__name">Tab bar</span><span class="kc__desc">The same four tabs on every screen</span>
      <nav class="s-tabs" data-tabs aria-label="Demo tab bar">
        <button type="button" class="is-on"><svg viewBox="0 0 24 24"><path d="M4 11 12 4l8 7v9H4z"/></svg>Home</button>
        <button type="button"><svg viewBox="0 0 24 24"><path d="M5 19h14M7 15l9-9 3 3-9 9H7z"/></svg>Account</button>
        <button type="button"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>Cards</button>
        <button type="button"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 4v8h8"/></svg>Statistics</button>
      </nav>
      <span class="kc__props"><b>icon</b> 1.8 stroke · <b>active</b> mint</span>
    </div>

    <div class="kc" data-c="confirm">
      <span class="kc__name">Confirmation</span><span class="kc__desc">End of every transfer</span>
      <button type="button" class="s-ok" data-ok>
        <span class="s-ok__c"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></svg></span>
        <span><b>Perfect!</b><small>The transfer has been sent.</small></span>
      </button>
      <span class="kc__props"><b>tick</b> draws 500ms · <b>tap</b> replay</span>
    </div>
  </div>
</div>

<style>
  .kit { --forest: #10382D; --moss: #1E5A46; --moss-l: #3F7A62; --mint: #A3FFA9; --mist: #E6F5EA; --dim: #8FB8A3; --card: #123F32;
    position: relative; color: var(--mist); font-family: var(--font-body); }
  .kit__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-2); }
  .kc:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 1800px) { .kit__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .kc:last-child:nth-child(odd) { grid-column: auto; } }
  .kc { position: relative; background: #0F362B; border-radius: var(--r-sm); padding: 64px 16px 40px; box-sizing: border-box; min-width: 0; min-height: 170px; display: flex; align-items: center; justify-content: center; transition: background var(--dur-base); }
  .kc:hover { background: #134635; }
  .kit__intro { color: var(--dim); padding: 2px 4px 12px; max-width: 60ch; }
  .kc__name { position: absolute; left: 16px; top: 14px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--mint); }
  .kc__desc { position: absolute; left: 16px; top: 32px; font-size: 12px; color: var(--dim); }
  .kc__props { position: absolute; left: 16px; right: 16px; bottom: 11px; font-family: var(--font-mono); font-size: 10px; color: var(--dim); opacity: 0; transform: translateY(4px); transition: opacity var(--dur-base), transform var(--dur-base) var(--ease-out); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .kc__props b { color: var(--mint); font-weight: 400; }
  .kc:hover .kc__props, .kc:focus-within .kc__props { opacity: 1; transform: none; }
  .kit button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }

  .s-btn { background: var(--mint); color: #0C2C23; border-radius: 8px; height: 48px; padding: 0 36px; font-size: 16px; font-weight: 500; transition: transform 140ms var(--ease-out), background 140ms; }
  .s-btn:hover { background: #B8FFBD; }
  .s-btn:active, .s-btn.is-press { transform: scale(0.94); }

  .s-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .s-chip { border: 1.5px solid var(--moss-l); border-radius: 8px; padding: 8px 9px; font-size: 12px; white-space: nowrap; transition: background 160ms, border-color 160ms, transform 140ms var(--ease-out); }
  .s-chip:hover { border-color: var(--mint); }
  .s-chip:active { transform: scale(0.95); }
  .s-chip.is-on { background: rgba(163, 255, 169, 0.12); border-color: var(--mint); color: var(--mint); }

  .s-seg { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); width: 100%; max-width: 300px; box-sizing: border-box; height: 42px; border: 1.5px solid var(--moss-l); border-radius: 8px; }
  .s-seg button { position: relative; z-index: 1; font-size: 11px; padding: 0; letter-spacing: -0.01em; transition: color 200ms; }
  .s-seg button.is-on { color: var(--mint); font-weight: 500; }
  .s-seg__thumb { position: absolute; top: -1.5px; bottom: -1.5px; left: 0; width: 25%; box-sizing: border-box; background: var(--moss); border: 1.5px solid var(--mint); border-radius: 7px; transform: translateX(calc(var(--x, 0) * 100%)); transition: transform 320ms var(--ease-spring); }

  .s-opts { display: flex; flex-direction: column; gap: 6px; width: 100%; max-width: 300px; }
  .s-opt { text-align: left; background: var(--moss); border-radius: 6px; padding: 10px 14px; display: flex; flex-direction: column; gap: 2px; box-shadow: 0 0 0 0 var(--mint); transition: box-shadow 200ms, background 200ms; }
  .s-opt b { color: var(--mint); font-size: 14px; font-weight: 500; }
  .s-opt span { font-size: 11.5px; color: #BFD9CA; }
  .s-opt.is-on { box-shadow: 0 0 0 2px var(--mint); background: #2A7A5C; }

  .s-grp { background: var(--moss); border-radius: 6px; padding: 12px 14px; width: 100%; max-width: 300px; display: flex; justify-content: space-between; align-items: center; }
  .s-grp b { display: block; font-size: 16px; font-weight: 500; color: var(--mint); }
  .s-grp small { display: block; font-size: 11px; color: var(--dim); }
  .s-grp__n { display: grid; grid-template-columns: 26px auto 26px; grid-template-rows: auto auto; align-items: center; justify-items: center; column-gap: 2px; }
  .s-grp__n b { font-size: 24px; font-variant-numeric: tabular-nums; min-width: 2ch; text-align: center; }
  .s-grp__n small { grid-column: 1 / -1; }
  .s-grp__n button { width: 26px; height: 26px; border-radius: 50%; color: var(--mint); font-size: 18px; line-height: 1; transition: background 140ms; }
  .s-grp__n button:hover { background: rgba(163, 255, 169, 0.14); }
  .s-grp__n b.is-bump { animation: bump 240ms var(--ease-out); }
  @keyframes bump { 40% { transform: scale(1.25); } }

  .s-date { display: flex; align-items: center; border: 1.5px solid var(--moss-l); border-radius: 8px; width: 100%; max-width: 300px; text-align: left; transition: border-color 160ms; }
  .s-date:hover { border-color: var(--mint); }
  .s-date__d { padding: 8px 14px; border-right: 1.5px solid var(--moss-l); color: var(--mint); line-height: 1; display: flex; flex-direction: column; gap: 2px; min-width: 54px; }
  .s-date__d b { font-size: 26px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .s-date__d span { font-size: 12px; }
  .s-date__t { padding: 0 14px; display: flex; flex-direction: column; gap: 2px; }
  .s-date__t b { font-size: 13px; font-weight: 500; }
  .s-date__t em { font-size: 11px; color: var(--dim); }
  .s-date__d.is-flip b { animation: flip 300ms var(--ease-out); }
  @keyframes flip { 0% { transform: translateY(-10px); opacity: 0; } 100% { transform: none; opacity: 1; } }

  .s-inp { position: relative; display: block; width: 100%; max-width: 300px; }
  .s-inp input { width: 100%; box-sizing: border-box; height: 46px; background: #174836; border: 1.5px solid var(--moss-l); border-radius: 6px; padding: 0 44px 0 14px; color: var(--mist); font-family: var(--font-body); font-size: 14px; outline: none; transition: border-color 160ms, box-shadow 160ms; }
  .s-inp input::placeholder { color: #6FA58C; }
  .s-inp input:focus { border-color: var(--mint); box-shadow: 0 0 0 3px rgba(163, 255, 169, 0.18); }
  .s-inp__ok { position: absolute; right: 12px; top: 50%; width: 20px; height: 20px; margin-top: -10px; border-radius: 50%; background: var(--mint); display: grid; place-items: center; transform: scale(0); transition: transform 240ms var(--ease-spring); }
  .s-inp__ok svg { width: 12px; height: 12px; fill: none; stroke: #0C2C23; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .s-inp.is-valid .s-inp__ok { transform: scale(1); }

  .s-tabs { display: grid; grid-template-columns: repeat(4, 1fr); width: 100%; max-width: 300px; }
  .s-tabs button { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 10.5px; color: #BFD9CA; transition: color 200ms; }
  .s-tabs svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 300ms var(--ease-spring); }
    .s-tabs button:hover { color: var(--mist); }
  .s-tabs button.is-on { color: var(--mint); }
  .s-tabs button.is-on svg { transform: none; }

  .s-ok { display: flex; align-items: center; gap: 14px; text-align: left; }
  .s-ok__c { width: 56px; height: 56px; border-radius: 50%; background: var(--mint); display: grid; place-items: center; flex: none; transition: transform 200ms var(--ease-spring); }
  .s-ok:active .s-ok__c { transform: scale(0.9); }
  .s-ok__c svg { width: 30px; height: 30px; fill: none; stroke: #0C2C23; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 24; stroke-dashoffset: 24; }
  .s-ok.is-in .s-ok__c svg { animation: tick 500ms var(--ease-out) 150ms forwards; }
  @keyframes tick { to { stroke-dashoffset: 0; } }
  .s-ok b { display: block; color: var(--mint); font-size: 16px; font-weight: 500; }
  .s-ok small { display: block; font-size: 11.5px; color: #BFD9CA; }

  @media (max-width: 640px) { .kit__grid { grid-template-columns: 1fr; } .kc__props { opacity: 1; transform: none; } }
</style>

<script>
  function initKit() {
    document.querySelectorAll<HTMLElement>('[data-kit="south"]').forEach((kit) => {
      if (kit.dataset.ready) return; kit.dataset.ready = '1';
      // Button: a press that also fires from the keyboard.
      kit.querySelector<HTMLButtonElement>('[data-btn]')?.addEventListener('click', (e) => { const b = e.currentTarget as HTMLElement; b.classList.add('is-press'); setTimeout(() => b.classList.remove('is-press'), 160); });
      // Chips toggle.
      kit.querySelectorAll('[data-chip]').forEach((c) => c.addEventListener('click', () => c.classList.toggle('is-on')));
      // Segmented control: the thumb springs to the pressed option.
      const seg = kit.querySelector<HTMLElement>('[data-seg]');
      seg?.querySelectorAll('button').forEach((b, i) => b.addEventListener('click', () => {
        seg.querySelectorAll('button').forEach((x) => x.classList.remove('is-on')); b.classList.add('is-on');
        (seg.querySelector('.s-seg__thumb') as HTMLElement).style.setProperty('--x', String(i));
      }));
      // Option cards: one selected.
      const opts = kit.querySelector('[data-opts]');
      opts?.querySelectorAll('.s-opt').forEach((o) => o.addEventListener('click', () => { opts.querySelectorAll('.s-opt').forEach((x) => x.classList.remove('is-on')); o.classList.add('is-on'); }));
      // Group counter, 1 to 10.
      const count = kit.querySelector<HTMLElement>('[data-count]');
      const step = (d: number) => { if (!count) return; const n = Math.min(10, Math.max(1, Number(count.textContent) + d)); count.textContent = String(n); count.classList.remove('is-bump'); void count.offsetWidth; count.classList.add('is-bump'); };
      kit.querySelector('[data-inc]')?.addEventListener('click', () => step(1));
      kit.querySelector('[data-dec]')?.addEventListener('click', () => step(-1));
      // Scheduled payment: tap to move to the next month.
      const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      kit.querySelector('[data-date]')?.addEventListener('click', (e) => {
        const d = (e.currentTarget as HTMLElement).querySelector('.s-date__d') as HTMLElement; const m = d.querySelector('span')!;
        m.textContent = months[(months.indexOf(m.textContent || 'April') + 1) % 12];
        d.classList.remove('is-flip'); void d.offsetWidth; d.classList.add('is-flip');
      });
      // Input: a check appears when the email looks right.
      const inp = kit.querySelector<HTMLInputElement>('.s-inp input');
      inp?.addEventListener('input', () => inp.parentElement!.classList.toggle('is-valid', /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(inp.value)));
      // Tab bar.
      const tabs = kit.querySelector('[data-tabs]');
      tabs?.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { tabs.querySelectorAll('button').forEach((x) => x.classList.remove('is-on')); b.classList.add('is-on'); }));
      // Confirmation tick, on tap.
      const ok = kit.querySelector<HTMLElement>('[data-ok]');
      const tick = () => { if (!ok) return; ok.classList.remove('is-in'); void ok.offsetWidth; ok.classList.add('is-in'); };
      ok?.addEventListener('click', tick);
      // Demo: when the kit scrolls in it plays itself once (thumb slides, an option
      // is picked, people are added, a name is typed, a tab moves, the tick draws).
      // Any click stops the demo and hands over.
      const segBtns = seg ? [...seg.querySelectorAll('button')] : [];
      const optBtns = opts ? [...opts.querySelectorAll('.s-opt')] : [];
      const tabBtns = tabs ? [...tabs.querySelectorAll('button')] : [];
      let stop = false; kit.addEventListener('pointerdown', () => { stop = true; }, { once: true });
      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const click = (el?: Element | null) => { if (!stop && el) (el as HTMLElement).click(); };
      const type = async (text: string) => { if (!inp) return; inp.value = ''; for (const ch of text) { if (stop) return; inp.value += ch; inp.dispatchEvent(new Event('input')); await wait(55); } };
      const demo = async () => {
        await wait(500); click(segBtns[1]); await wait(600); click(segBtns[3]); await wait(700); click(segBtns[0]);
        await wait(300); click(optBtns[1]); await wait(500); click(optBtns[0]);
        await wait(200); step(1); await wait(260); step(1); await wait(260); step(-1);
        await wait(300); await type('david@atelier.com');
        await wait(300); click(tabBtns[1]); await wait(350); click(tabBtns[3]); await wait(350); click(tabBtns[0]);
        await wait(200); if (!stop) tick();
      };
      new IntersectionObserver((es, io) => es.forEach((e) => { if (e.isIntersecting) { demo(); io.disconnect(); } }), { threshold: 0.5 }).observe(kit);
    });
  }
  initKit();
  document.addEventListener('astro:page-load', initKit);
</script>
