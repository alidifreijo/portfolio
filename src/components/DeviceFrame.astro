---
/**
 * DeviceFrame · a screenshot shown in a browser window or a phone.
 * <DeviceFrame kind="browser" src="…" url="cut-scenes.vercel.app" />
 * <DeviceFrame kind="phone" src="…" />
 */
interface Props { kind?: 'browser' | 'phone'; src: string; alt?: string; url?: string; class?: string; style?: string }
const { kind = 'browser', src, alt = '', url = '', class: cls = '', style } = Astro.props;
---
{kind === 'browser' ? (
  <div class:list={['browser', cls]} style={style}>
    <div class="browser__bar" aria-hidden="true"><i></i><i></i><i></i>{url && <span>{url}</span>}</div>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
) : (
  <div class:list={['phone', cls]} style={style}>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
)}

<style>
  .browser { width: 100%; border-radius: 10px; overflow: hidden; background: #111212; box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.35); }
  .browser__bar { height: 26px; background: #1c1d1d; display: flex; align-items: center; gap: 6px; padding: 0 10px; }
  .browser__bar i { width: 8px; height: 8px; border-radius: 50%; background: #3a3b3b; }
  .browser__bar span { margin-left: 10px; font-family: var(--font-mono); font-size: 10px; color: var(--muted-ink); background: #111212; border-radius: 6px; padding: 2px 10px; }
  .browser img { width: 100%; }
  .phone { flex: 0 0 auto; width: 30%; max-width: 200px; aspect-ratio: 390 / 844; border-radius: 26px; overflow: hidden; background: #111212; box-shadow: 0 0 0 5px #161616, 0 22px 40px -14px rgba(0, 0, 0, 0.45); }
  .phone img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
</style>
