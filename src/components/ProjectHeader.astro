---
/**
 * ProjectHeader · title card in the project accent + meta cards.
 * Reads straight from a project entry.
 */
import Button from './Button.astro';
import { rich } from '../lib/utils';
interface Props {
  title: string;
  lead?: string;
  intro?: string;
  meta?: { label: string; value: string }[];
  links?: { label: string; url: string }[];
}
const { title, lead, intro, meta = [], links = [] } = Astro.props;
---
<div class="ph row" data-reveal>
  <div class="ph__title">
    <h1 class="t-display">{title}</h1>
    <p class="t-body"><strong>{lead}</strong> <Fragment set:html={rich(intro, false)} /></p>
    {links.length > 0 && (
      <div class="ph__links">
        {links.map((l, i) => <Button href={l.url} variant={i === 0 ? 'primary' : 'secondary'} icon="arrow">{l.label}</Button>)}
      </div>
    )}
  </div>
  {meta.length > 0 && (
    <dl class="ph__meta">
      {meta.map((m) => (
        <div class="ph__m"><dt>{m.label}</dt><dd>{m.value}</dd></div>
      ))}
    </dl>
  )}
</div>

<style>
  .ph__title { flex: 1.7 1 0; min-width: 0; background: var(--acc); color: var(--on-acc); border-radius: var(--r-lg); padding: var(--s-5); display: flex; flex-direction: column; gap: var(--s-3); }
  .ph__title h1 { margin-bottom: var(--s-1); }
  .ph__links { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-top: var(--s-1); }
  .ph__meta { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: var(--s-2); margin: 0; }
  .ph__m { flex: 1; display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); background: var(--acc); color: var(--on-acc); border-radius: var(--r-md); padding: var(--s-3) var(--s-4); font-size: var(--fs-small); }
  .ph__m dt { opacity: 0.7; }
  .ph__m dd { margin: 0; font-weight: 700; text-align: right; }
</style>
