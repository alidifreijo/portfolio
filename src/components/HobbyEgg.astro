---
/**
 * HobbyEgg · the "grab to know me" collage, as an easter egg. It stays
 * hidden until someone clicks the trigger (any [data-egg-open] button on the
 * page): then the stickers burst out of the trigger into a pile over a dark
 * layer. They can be thrown around (heavy, like the faces on the home page),
 * bounce off the screen edges and spin a little. Esc, the close button or a
 * click on the background sends them back where they came from.
 *
 * x / y: centre, w: width, in % of the pile box (desktop 574:876, phone
 * 366:564, as in the Framer original). ar: box proportions; fit: cover/fill.
 * Order = stacking order (last on top).
 */
const items = [
  { n: 'attack-on-titan', x: 50.0, y: 36.8, w: 30.3, ar: '174/98', fit: 'cover', mx: 47.1, my: 54.2, mw: 50.5 },
  { n: 'gilmore-girls', x: 71.6, y: 60.7, w: 21.6, ar: '124/152', fit: 'cover', mx: 47.1, my: 55.6, mw: 37.4 },
  { n: 'pedro-pascal', x: 45.1, y: 36.1, w: 19.5, ar: '112/140', fit: 'cover', mx: 47.0, my: 55.6, mw: 34.4 },
  { n: 'friends', x: 23.6, y: 68.9, w: 27.4, ar: '157/113', fit: 'cover', mx: 47.0, my: 54.5, mw: 45.4 },
  { n: 'harry-potter', x: 62.7, y: 38.2, w: 24.4, ar: '140/188', fit: 'cover', mx: 47.0, my: 55.9, mw: 42.1 },
  { n: 'zorro', x: 33.4, y: 48.0, w: 17.6, ar: '101/145', fit: 'cover', mx: 47.1, my: 55.9, mw: 32.0 },
  { n: 'crossword', x: 51.0, y: 73.4, w: 40.1, ar: '230/138', fit: 'cover', mx: 56.6, my: 46.2, mw: 64.5 },
  { n: 'coffee', x: 56.8, y: 55.4, w: 14.6, ar: '84/75', fit: 'fill', mx: 52.7, my: 45.6, mw: 20.8 },
  { n: 'normal-people', x: 52.9, y: 55.5, w: 27.4, ar: '157/108', fit: 'fill', mx: 42.6, my: 31.6, mw: 46.4 },
  { n: 'wall-e', x: 77.4, y: 42.8, w: 25.4, ar: '146/144', fit: 'cover', mx: 33.7, my: 79.2, mw: 43.4 },
  { n: 'utopia', x: 28.6, y: 33.8, w: 20.6, ar: '118/174', fit: 'cover', mx: 26.9, my: 75.4, mw: 36.3 },
  { n: 't-shirt', x: 27.5, y: 53.2, w: 40.1, ar: '230/182', fit: 'fill', mx: 65.6, my: 63.7, mw: 63.9 },
  { n: 'cat', x: 27.4, y: 75.7, w: 17.6, ar: '101/116', fit: 'fill', mx: 27.5, my: 80.0, mw: 30.9 },
  { n: 'animal-crossing', x: 39.2, y: 54.7, w: 15.7, ar: '90/146', fit: 'cover', r: -21, mx: 73.5, my: 65.2, mw: 22.4 },
  { n: 'fleabag', x: 58.8, y: 61.4, w: 37.1, ar: '213/200', fit: 'fill', mx: 72.1, my: 77.5, mw: 53.0 },
  { n: 'books', x: 16.7, y: 33.1, w: 30.3, ar: '174/132', fit: 'fill', mx: 76.1, my: 33.4, mw: 32.0 },
  { n: 'parks-and-rec', x: 83.3, y: 71.9, w: 24.4, ar: '140/212', fit: 'cover', mx: 19.9, my: 48.5, mw: 32.8 },
  { n: 'headphones', x: 15.8, y: 57.0, w: 16.6, ar: '95/112', fit: 'fill', r: -5, mx: 31.1, my: 37.8, mw: 23.2 },
];
const { title = 'grab to know me', label = 'interests & hobbies' } = Astro.props;
---
<div class="egg" data-egg role="dialog" aria-modal="true" aria-label={`${title}: ${label}`} hidden>
  <div class="egg__bg" data-egg-close></div>
  <p class="egg__title" aria-hidden="true"><em>grab</em> to<br />know me</p>
  <p class="egg__lab">{label}</p>
  <div class="egg__pile" data-egg-pile>
    {items.map((it, i) => (
      <img
        class="egg__st"
        src={`/images/hobbies/${it.n}.png`}
        alt={it.n.replace(/-/g, ' ')}
        draggable="false"
        style={`--x:${it.x}%;--y:${it.y}%;--w:${it.w}%;--ar:${it.ar};--mx:${it.mx}%;--my:${it.my}%;--mw:${it.mw}%;--r:${(it as any).r || 0}deg;object-fit:${it.fit};z-index:${i + 1}`}
      />
    ))}
  </div>
  <p class="egg__hint">Throw them around · <kbd>Esc</kbd> to put them back</p>
  <button class="egg__close" type="button" data-egg-close aria-label="Close">Close <span aria-hidden="true">×</span></button>
  <img class="egg__ice" src="/images/hobbies/ice-cream.png" alt="" aria-hidden="true" data-egg-ice />
</div>

<script>
  function initEgg() {
    const egg = document.querySelector<HTMLElement>('[data-egg]');
    if (!egg || egg.dataset.ready) return; egg.dataset.ready = '1';
    const pile = egg.querySelector<HTMLElement>('[data-egg-pile]')!;
    const els = [...pile.querySelectorAll<HTMLImageElement>('.egg__st')];
    const ice = egg.querySelector<HTMLElement>('[data-egg-ice]')!;
    const closeBtn = egg.querySelector<HTMLButtonElement>('.egg__close')!;
    const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    type S = { el: HTMLElement; dx: number; dy: number; vx: number; vy: number; r: number; vr: number; held: boolean; trail: number[][] };
    const st: S[] = els.map((el) => ({ el, dx: 0, dy: 0, vx: 0, vy: 0, r: 0, vr: 0, held: false, trail: [] }));
    let z = 100, loop = 0, opener: HTMLElement | null = null, open = false;
    const paint = (o: S) => { o.el.style.translate = `${o.dx.toFixed(1)}px ${o.dy.toFixed(1)}px`; o.el.style.rotate = `${o.r.toFixed(2)}deg`; };

    // the physics: heavy and a little slow, like the faces on the home page
    const step = () => {
      loop = 0; if (!open) return;
      const W = innerWidth, H = innerHeight; let busy = false;
      for (const o of st) {
        if (!o.held) { o.vx *= 0.979; o.vy *= 0.979; o.dx += o.vx; o.dy += o.vy; }
        const b = o.el.getBoundingClientRect(), m = 0.35; // let a third of it leave the screen
        if (b.left < -b.width * m && o.vx < 0) { o.vx = -o.vx * 0.45; o.vr += o.vy * 0.3; }
        if (b.right > W + b.width * m && o.vx > 0) { o.vx = -o.vx * 0.45; o.vr -= o.vy * 0.3; }
        if (b.top < -b.height * m && o.vy < 0) { o.vy = -o.vy * 0.45; o.vr -= o.vx * 0.3; }
        if (b.bottom > H + b.height * m && o.vy > 0) { o.vy = -o.vy * 0.45; o.vr += o.vx * 0.3; }
        o.vr += -o.r * 0.012; o.vr *= 0.93; o.r += o.vr * 0.6;
        paint(o);
        if (o.held || Math.hypot(o.vx, o.vy) > 0.08 || Math.abs(o.r) > 0.05 || Math.abs(o.vr) > 0.05) busy = true;
      }
      if (busy) loop = requestAnimationFrame(step);
    };
    const wake = () => { if (!loop) loop = requestAnimationFrame(step); };

    st.forEach((o) => {
      const el = o.el; let sx = 0, sy = 0, ox = 0, oy = 0;
      el.addEventListener('dragstart', (e) => e.preventDefault());
      el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        if (e.pointerType === 'mouse') e.preventDefault();
        o.held = true; o.vx = o.vy = 0;
        sx = e.clientX; sy = e.clientY; ox = o.dx; oy = o.dy; o.trail = [[e.timeStamp, e.clientX, e.clientY]];
        el.style.zIndex = String(++z); el.classList.add('is-drag');
        el.setPointerCapture(e.pointerId); wake();
      });
      const track = (e: PointerEvent) => {
        o.dx = ox + e.clientX - sx; o.dy = oy + e.clientY - sy;
        o.trail.push([e.timeStamp, e.clientX, e.clientY]);
        while (o.trail.length > 2 && e.timeStamp - o.trail[0][0] > 80) o.trail.shift();
        const t0 = o.trail[0], dt = e.timeStamp - t0[0];
        if (dt > 0) { o.vx = ((e.clientX - t0[1]) / dt) * 16.7; o.vy = ((e.clientY - t0[2]) / dt) * 16.7; }
        o.vr = o.vx * 0.15;
      };
      el.addEventListener('pointermove', (e) => { if (o.held) track(e); });
      const end = (e: PointerEvent) => {
        if (!o.held) return;
        if (e.type === 'pointerup') track(e);
        o.held = false; el.classList.remove('is-drag');
        if (e.timeStamp - o.trail[o.trail.length - 1][0] > 100 || o.trail.length < 2) { o.vx = o.vy = 0; }
        o.vx *= 0.5; o.vy *= 0.5;
        const sp = Math.hypot(o.vx, o.vy), cap = reduce() ? 0 : 30;
        if (sp > cap) { o.vx *= cap / (sp || 1); o.vy *= cap / (sp || 1); }
        wake();
      };
      el.addEventListener('pointerup', end); el.addEventListener('pointercancel', end);
    });

    // where the trigger is, relative to each sticker's home spot
    const fromOpener = (o: S) => {
      const b = opener?.getBoundingClientRect(); if (!b) return [0, 0];
      const h = o.el.getBoundingClientRect();
      // home centre = current centre minus the current offset
      const hx = h.left + h.width / 2 - o.dx, hy = h.top + h.height / 2 - o.dy;
      return [b.left + b.width / 2 - hx, b.top + b.height / 2 - hy];
    };

    const show = (from: HTMLElement) => {
      if (open) return; open = true; opener = from;
      egg.hidden = false; document.documentElement.classList.add('egg-open');
      st.forEach((o) => { o.dx = o.dy = o.vx = o.vy = o.r = o.vr = 0; paint(o); });
      requestAnimationFrame(() => {
        egg.classList.add('is-open');
        if (!reduce()) st.forEach((o, i) => {
          const [fx, fy] = fromOpener(o);
          o.el.animate(
            [{ translate: `${fx}px ${fy}px`, scale: 0.1, rotate: `${(i % 2 ? 1 : -1) * 40}deg`, opacity: 0 }, { translate: '0px 0px', scale: 1, rotate: '0deg', opacity: 1 }],
            { duration: 900, delay: 120 + i * 40, easing: 'cubic-bezier(.3,1.25,.5,1)', fill: 'backwards' }
          );
        });
        closeBtn.focus({ preventScroll: true });
      });
    };
    const hide = () => {
      if (!open) return; open = false; cancelAnimationFrame(loop); loop = 0;
      egg.classList.remove('is-open');
      const done = () => {
        egg.hidden = true; document.documentElement.classList.remove('egg-open');
        st.forEach((o) => { o.el.getAnimations().forEach((a) => a.cancel()); });
        opener?.focus({ preventScroll: true });
      };
      if (reduce()) { done(); return; }
      // they get sucked back into the trigger
      const anims = st.map((o, i) => {
        const [fx, fy] = fromOpener(o);
        return o.el.animate(
          [{ translate: `${o.dx}px ${o.dy}px`, scale: 1, opacity: 1 }, { translate: `${fx + o.dx}px ${fy + o.dy}px`, scale: 0.1, opacity: 0 }],
          { duration: 520, delay: (st.length - i) * 18, easing: 'cubic-bezier(.6,0,.8,.4)', fill: 'forwards' }
        );
      });
      Promise.all(anims.map((a) => a.finished)).then(done, done);
    };

    document.querySelectorAll<HTMLElement>('[data-egg-open]').forEach((b) => b.addEventListener('click', () => show(b)));
    egg.querySelectorAll<HTMLElement>('[data-egg-close]').forEach((b) => b.addEventListener('click', hide));
    addEventListener('keydown', (e) => { if (open && e.key === 'Escape') hide(); });
    // keep the keyboard inside: the close button is the only control
    egg.addEventListener('keydown', (e) => { if (e.key === 'Tab') { e.preventDefault(); closeBtn.focus(); } });
    document.addEventListener('astro:before-swap', () => { if (open) { open = false; document.documentElement.classList.remove('egg-open'); } }, { once: true });

    // the ice cream follows the cursor while the collage is open
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let tx = -200, ty = -200, x = -200, y = -200, raf = 0;
      const follow = () => {
        x += (tx - x) * 0.16; y += (ty - y) * 0.16;
        ice.style.transform = `translate(${x - 44.5}px, ${y}px)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.3 ? requestAnimationFrame(follow) : 0;
      };
      egg.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        tx = e.clientX; ty = e.clientY;
        if (!ice.classList.contains('is-on')) { x = tx; y = ty; ice.classList.add('is-on'); }
        if (!raf) raf = requestAnimationFrame(follow);
      });
      egg.addEventListener('pointerleave', () => ice.classList.remove('is-on'));
    }
  }
  initEgg();
  document.addEventListener('astro:page-load', initEgg);
</script>

<style>
  :global(html.egg-open) { overflow: hidden; }
  .egg { position: fixed; inset: 0; z-index: 200; overflow: hidden; touch-action: none; }
  .egg[hidden] { display: none; }
  .egg__bg { position: absolute; inset: 0; background: rgba(7, 7, 7, 0.94); opacity: 0; transition: opacity 400ms var(--ease-out); }
  .egg.is-open .egg__bg { opacity: 1; }
  .egg__title {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; margin: 0; pointer-events: none;
    font-family: var(--font-serif); font-size: clamp(90px, 15vw, 300px); line-height: 0.8; letter-spacing: -0.035em; text-align: center;
    color: #2a2926; opacity: 0; transition: opacity 600ms var(--ease-out) 200ms;
  }
  .egg__title em { font-style: italic; }
  .egg.is-open .egg__title { opacity: 1; }
  .egg__lab, .egg__hint {
    position: absolute; left: 24px; margin: 0; z-index: 1; pointer-events: none;
    font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.45; color: var(--muted-ink);
    opacity: 0; transition: opacity 400ms var(--ease-out) 300ms;
  }
  .egg__lab { top: 22px; color: var(--on-chrome); }
  .egg__hint { bottom: 20px; }
  .egg__hint kbd { font: inherit; border: 1px solid currentColor; border-radius: 4px; padding: 0 4px; }
  .egg.is-open :is(.egg__lab, .egg__hint, .egg__close) { opacity: 1; }
  .egg__close {
    all: unset; cursor: pointer; position: absolute; top: 14px; right: 16px; z-index: 300;
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 22px;
    border: 1px solid var(--on-chrome); color: var(--on-chrome);
    font-family: var(--font-body); font-size: 13px; opacity: 0; transition: opacity 400ms var(--ease-out) 300ms, background 200ms, color 200ms;
  }
  .egg__close:hover, .egg__close:focus-visible { background: var(--on-chrome); color: #070707; }
  .egg__close:focus-visible { outline: 2px solid var(--on-chrome); outline-offset: 3px; }
  .egg__close span { font-size: 18px; line-height: 1; }

  /* the pile: the original box, centred; stickers can be thrown out of it */
  .egg__pile { position: absolute; left: 50%; top: 52%; translate: -50% -50%; height: min(86vh, 900px); aspect-ratio: 574 / 876; }
  .egg__st {
    position: absolute; left: var(--x); top: var(--y); width: var(--w); height: auto; aspect-ratio: var(--ar);
    transform: translate(-50%, -50%) rotate(var(--r)); cursor: grab; user-select: none; -webkit-user-drag: none;
    transition: scale 200ms var(--ease-out);
  }
  .egg__st.is-drag { cursor: grabbing; scale: 1.05; }
  .egg__ice { position: fixed; left: 0; top: 0; width: 89px; height: 105px; object-fit: contain; z-index: 400; pointer-events: none; opacity: 0; transition: opacity 200ms; will-change: transform; }
  .egg__ice:global(.is-on) { opacity: 1; }
  @media (max-width: 809px) {
    .egg__pile { height: auto; width: 100%; aspect-ratio: 366 / 564; max-height: 82vh; top: 54%; }
    .egg__st { left: var(--mx); top: var(--my); width: var(--mw); }
    .egg__hint { display: none; }
  }
</style>
