---
/**
 * TitleCard · how a case or page introduces itself: its name in the serif
 * voice (the important part in italics: `**name**`) and its facts as data pairs.
 */
import DataPair from './DataPair.astro';
import { emph } from '../../lib/utils';
interface Props { title: string; facts?: { label: string; value: string }[]; level?: 1 | 2 }
const { title, facts = [], level = 1 } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
---
<header class="tc">
  <H class="tc__t" set:html={emph(title)} />
  {facts.length > 0 && <dl class="tc__f">{facts.map((f) => <DataPair label={f.label} value={f.value} />)}</dl>}
</header>

<style>
  .tc { display: flex; flex-direction: column; gap: var(--s-5); }
  .tc__t { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: var(--fs-section); line-height: var(--lh-section); color: var(--ink); }
  .tc__t :global(em) { font-style: italic; }
  .tc__f { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--s-4) var(--s-5); margin: 0; padding-top: var(--s-4); border-top: 1px solid var(--line); }
</style>
