---
/**
 * Footer · the same on every page (task 6 puts it on them): LinkedIn, the CV
 * and "Let's talk". Links come from the Contact page in Keystatic.
 */
import { getEntry } from 'astro:content';
const contact = (await getEntry('pages', 'contact'))!.data as any;
const linkedin = (contact.links || []).find((l: any) => /linkedin/i.test(l.label) || /linkedin\.com/.test(l.url));
const cv = contact.cv as string | undefined;
---
<footer class="ft">
  <p class="ft__n">álida díaz de freijo</p>
  <ul class="ft__l">
    {linkedin && <li><a href={linkedin.url} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a></li>}
    {cv && <li><a href={cv} download>CV <span aria-hidden="true">↓</span></a></li>}
    <li><a href="/contact">Let’s talk <span aria-hidden="true">→</span></a></li>
  </ul>
</footer>

<style>
  .ft { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: var(--s-4); padding: var(--s-5) var(--s-3); color: var(--paper); }
  .ft__n { margin: 0; font-family: var(--font-serif); font-style: italic; font-size: var(--fs-chapter); line-height: var(--lh-chapter); }
  .ft__l { display: flex; gap: var(--s-6); list-style: none; margin: 0; padding: 0; }
  .ft__l a {
    font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-label); line-height: var(--lh-label);
    letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--paper); text-decoration: none;
  }
  .ft__l a span { color: var(--red); }
  .ft__l a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
</style>
