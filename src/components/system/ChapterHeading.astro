---
/**
 * ChapterHeading · a numbered chapter: the number in the case's agent colour
 * (a pill, so it reads on paper) and the title in the serif voice.
 * Set --acc / --on-acc on a parent (accentVars) to colour the number.
 */
import { emph } from '../../lib/utils';
interface Props { n: number | string; title: string; id?: string }
const { n, title, id } = Astro.props;
const num = typeof n === 'number' ? String(n).padStart(2, '0') : n;
---
<h2 class="ch" id={id}>
  <span class="ch__n">{num}</span>
  <span class="ch__t" set:html={emph(title)} />
</h2>

<style>
  .ch { display: flex; align-items: baseline; gap: var(--s-3); margin: 0; font-weight: 400; }
  .ch__n {
    flex: none; transform: translateY(-0.35em);
    font-family: var(--font-ui); font-weight: 500; font-size: var(--fs-label); line-height: var(--lh-label); letter-spacing: var(--ls-label);
    background: var(--acc, var(--ink)); color: var(--on-acc, var(--paper)); border-radius: var(--r-pill); padding: var(--s-1) var(--s-2);
  }
  .ch__t { font-family: var(--font-serif); font-size: var(--fs-chapter); line-height: var(--lh-chapter); color: currentColor; }
  .ch__t :global(em) { font-style: italic; }
</style>
