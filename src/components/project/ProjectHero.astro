---
/**
 * ProjectHero · the big panel on the left of a project. It stays put
 * while the right column scrolls. Three styles:
 * - cover: image or video fills the panel
 * - contain: video/image centred on a flat colour
 * - phone: a video playing inside a phone frame, on a flat colour
 */
import Tab from '../Tab.astro';
import { isVideo } from '../../lib/utils';
interface Props {
  src: string;
  style?: 'cover' | 'contain' | 'phone';
  bg?: string;
  frame?: string;     // phone style: the frame PNG
  label?: string;
}
const { src, style = 'cover', bg = '#111212', frame, label } = Astro.props;
const poster = (s: string) => s.replace(/\.mp4$/i, '.poster.jpg');
---
<div class:list={['hero', `hero--${style}`]} style={`background:${bg}`}>
  {style === 'phone' ? (
    <div class="hero__phone">
      <video src={src} poster={poster(src)} muted loop playsinline autoplay data-autoplay></video>
      {frame && <img class="hero__frame" src={frame} alt="" />}
    </div>
  ) : isVideo(src) ? (
    <video src={src} poster={poster(src)} muted loop playsinline autoplay data-autoplay></video>
  ) : (
    <img src={src} alt="" loading="eager" />
  )}
  {label && <Tab corner="bottom-right"><span class="t-body">{label}</span></Tab>}
</div>

<style>
  .hero { position: relative; height: 100%; border-radius: var(--r-md); overflow: hidden; }
  .hero > img, .hero > video { width: 100%; height: 100%; object-fit: cover; }
  .hero--contain > img, .hero--contain > video { object-fit: contain; }
  /* Phone: frame 323×582 with the screen inset, as in the original (panel 850×876). */
  .hero__phone { position: absolute; left: 50%; top: 50%; translate: -50% -50%; height: 78%; max-width: 86%; aspect-ratio: 323 / 582; }
  .hero__phone video { position: absolute; left: 11.5%; top: 4.8%; width: 77%; height: 93%; object-fit: cover; border-radius: 17.7% / 8.1%; }
  .hero__frame { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
