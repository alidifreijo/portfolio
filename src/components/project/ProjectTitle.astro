---
/**
 * ProjectTitle · v2: paper card with the facts, the name in serif and the intro.
 * `display` supports **bold** (e.g. "**fintech** app").
 */
import { rich } from '../../lib/utils';
import Button from '../Button.astro';
interface Props {
  display: string;
  intro: string;
  meta: { label: string; value: string }[];
  metaWidth?: number;
  links?: { label: string; url: string }[];
}
const { display, intro, meta, links = [] } = Astro.props;
---
<header class="ct">
  <dl class="ct__meta">
    {meta.map((m) => (
      <div class="ct__m"><dt>{m.label}</dt><dd>{m.value}</dd></div>
    ))}
  </dl>
  <h1 class="ct__h" set:html={rich(display, false)} />
  <div class="ct__intro" set:html={rich(intro, false)} />
  {links.length > 0 && (
    <div class="ct__links">
      {links.map((l, i) => <Button href={l.url} variant={i === 0 ? 'primary' : 'secondary'} icon="arrow">{l.label}</Button>)}
    </div>
  )}
  <span class="ct__acc" aria-hidden="true"></span>
</header>

<style>
  /* v2: a paper card. The facts as label + value on top, the name in serif
     (the **bold** part in italics), the intro in plain reading size. */
  .ct { position: relative; background: var(--paper); color: #070707; border-radius: var(--r-md); padding: 24px 28px 28px; display: flex; flex-direction: column; gap: 22px; }
  .ct__meta { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px 16px; padding-right: 30px; }
  .ct__m dt { font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.45; color: #57534d; }
  .ct__m dd { margin: 0; font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.45; }
  .ct__h { margin: 8px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: clamp(56px, 6vw, 112px); line-height: 0.85; letter-spacing: -0.035em; }
  .ct__h :global(strong) { font-weight: 400; font-style: italic; }
  .ct__intro { font-family: var(--font-body); font-size: clamp(15px, 1.1vw, 18px); line-height: 1.55; max-width: 52ch; color: #2b2925; }
  .ct__intro :global(strong) { font-weight: 500; color: #070707; }
  .ct__links { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  /* the project colour, as a small square in the corner */
  .ct__acc { position: absolute; top: 26px; right: 28px; width: 14px; height: 14px; border-radius: 3px; background: var(--acc); }
  @media (max-width: 809px) { .ct { padding: 20px 16px 24px; } .ct__acc { right: 16px; } }
</style>
