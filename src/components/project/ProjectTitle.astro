---
/**
 * ProjectTitle · v2, two parts:
 * - the bar, pinned on top of the right column while you read: the name,
 *   the facts in one line and, on cases with chapters, the chapters (the one
 *   being read is sharp, the rest blurred; click one to jump there) with a
 *   reading-progress line;
 * - the intro, which scrolls away with the content.
 * `display` supports **bold** (e.g. "**hmi** display").
 */
import { rich } from '../../lib/utils';
import Button from '../Button.astro';
interface Props {
  display: string;
  intro: string;
  meta: { label: string; value: string }[];
  links?: { label: string; url: string }[];
  chapters?: { n: number; title: string }[];
  part: 'bar' | 'intro';
}
const { display, intro, meta, links = [], chapters = [], part } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
{part === 'bar' ? (
  <header class="pb" data-pb>
    <div class="pb__top">
      <h1 class="pb__h" set:html={rich(display, false)} />
      <dl class="pb__meta">
        {meta.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}
      </dl>
      <span class="pb__acc" aria-hidden="true"></span>
    </div>
    {chapters.length > 0 && (
      <nav class="pb__nav" aria-label="Chapters">
        {chapters.map((c, i) => (
          <a href={`#chapter-${c.n}`} class:list={['pb__chap', { 'is-on': i === 0 }]} data-pb-chap={c.n} aria-current={i === 0 ? 'step' : undefined}>
            <span class="pb__n">{pad(c.n)}</span> {c.title}
          </a>
        ))}
      </nav>
    )}
    <span class="pb__prog" aria-hidden="true"><span data-pb-prog></span></span>
  </header>
) : (
  <div class="pi">
    <div class="pi__text" set:html={rich(intro, false)} />
    {links.length > 0 && (
      <div class="pi__links">
        {links.map((l, i) => <Button href={l.url} variant={i === 0 ? 'primary' : 'secondary'} icon="arrow">{l.label}</Button>)}
      </div>
    )}
  </div>
)}

<script>
  function initBar() {
    const bar = document.querySelector<HTMLElement>('[data-pb]');
    if (!bar || bar.dataset.ready) return; bar.dataset.ready = '1';
    const chaps = [...bar.querySelectorAll<HTMLElement>('[data-pb-chap]')];
    const prog = bar.querySelector<HTMLElement>('[data-pb-prog]')!;
    // the chapter being read (sent by the page)
    document.addEventListener('chapter:change', (e) => {
      const id = String((e as CustomEvent).detail || '1');
      chaps.forEach((c) => { const on = c.dataset.pbChap === id; c.classList.toggle('is-on', on); on ? c.setAttribute('aria-current', 'step') : c.removeAttribute('aria-current'); });
    });
    // how far through the case you are
    let raf = 0;
    const tick = () => {
      raf = 0; if (!bar.isConnected) { removeEventListener('scroll', onScroll); return; }
      const max = document.documentElement.scrollHeight - innerHeight;
      prog.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(tick); };
    addEventListener('scroll', onScroll, { passive: true }); tick();
  }
  initBar();
  document.addEventListener('astro:page-load', initBar);
</script>

<style>
  /* the bar */
  .pb {
    position: relative; background: var(--paper); color: #070707; border-radius: var(--r-md); padding: 18px 24px 16px;
    display: flex; flex-direction: column; gap: 14px; overflow: hidden;
  }
  .pb__top { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 28px; flex-wrap: wrap; padding-right: 26px; }
  .pb__h { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(32px, 3vw, 52px); line-height: 0.95; letter-spacing: -0.03em; }
  .pb__h :global(strong) { font-weight: 700; }
  .pb__meta { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .pb__meta dt { font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.4; color: #57534d; }
  .pb__meta dd { margin: 0; font-family: var(--font-body); font-size: var(--fs-print); line-height: 1.4; }
  .pb__acc { position: absolute; top: 20px; right: 24px; width: 12px; height: 12px; border-radius: 3px; background: var(--acc); }
  .pb__nav { display: flex; flex-wrap: wrap; gap: 6px 22px; border-top: 1px solid #b9b5ae; padding-top: 12px; }
  .pb__chap {
    display: inline-flex; align-items: baseline; gap: 6px; min-height: 28px; text-decoration: none; color: #070707;
    font-family: var(--font-display); font-weight: 500; text-transform: uppercase; font-size: clamp(14px, 1.15vw, 18px); line-height: 1.1;
    opacity: 0.35; filter: blur(1.2px); transition: opacity 400ms var(--ease-out), filter 400ms var(--ease-out);
  }
  .pb__chap:hover, .pb__chap:focus-visible, .pb__chap.is-on { opacity: 1; filter: none; }
  .pb__chap:focus-visible { outline: 2px solid #070707; outline-offset: 3px; }
  .pb__n { font-family: var(--font-body); font-weight: 400; font-size: var(--fs-print); }
  .pb__prog { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(7, 7, 7, 0.08); }
  .pb__prog span { display: block; height: 100%; background: var(--acc); transform-origin: 0 50%; transform: scaleX(0); }
  @media (prefers-reduced-motion: reduce) { .pb__chap { transition: none; } }

  /* the intro, first thing in the content */
  .pi { background: var(--paper); color: #070707; border-radius: var(--r-md); padding: 22px 24px 24px; }
  .pi__text { font-family: var(--font-body); font-size: clamp(16px, 1.2vw, 20px); line-height: 1.5; max-width: 52ch; color: #2b2925; }
  .pi__text :global(strong) { font-weight: 500; color: #070707; }
  .pi__links { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: 16px; }
  @media (max-width: 809px) { .pb { padding: 14px 16px 14px; } .pb__acc { right: 16px; } .pi { padding: 18px 16px 20px; } }
</style>
