---
/**
 * Base layout · every page uses it. Handles <head>, fonts, the menu,
 * and the scroll-reveal motion.
 */
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  nav?: boolean;
}
const {
  title,
  description = 'Álida Díaz de Freijo, senior product designer in Barcelona. Complex things, made to feel simple.',
  image = '/images/brand/og.png',
  nav = true,
} = Astro.props;
// The static preview (relative URLs) can't use client-side routing; Vercel can.
const clientRouter = !process.env.PREVIEW;
const fullTitle = title ? `${title} · álida díaz de freijo` : 'álida díaz de freijo · product designer';
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#070707" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    {clientRouter && <ClientRouter />}
  </head>
  <body>
    {nav && <Nav />}
    <main class="frame">
      <slot />
    </main>
    <script>
      function initPage() {
      // Reveal on scroll · one observer for the whole site.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        els.forEach((el) => io.observe(el));
        // Safety net: at the very bottom of the page, show anything still hidden.
        addEventListener('scroll', () => {
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 40) {
            els.forEach((el) => el.classList.add('is-in'));
          }
        }, { passive: true });
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
      // Pause videos that are off screen, play them when visible.
      const vids = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
      const vo = new IntersectionObserver((entries) => entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => {}); else v.pause();
      }), { threshold: 0.15 });
      vids.forEach((v) => vo.observe(v));
      // Story videos play once when they come into view and freeze on the last
      // frame. Scroll past before the end and they start over next time.
      const once = document.querySelectorAll<HTMLVideoElement>('video[data-once]');
      const oo = new IntersectionObserver((entries) => entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) { if (!v.ended) v.play().catch(() => {}); }
        else if (!v.ended) { v.pause(); v.currentTime = 0; }
      }), { threshold: 0.5 });
      once.forEach((v) => {
        oo.observe(v);
        const box = v.parentElement as HTMLElement;
        v.addEventListener('play', () => box.classList.add('is-playing'));
        v.addEventListener('pause', () => box.classList.remove('is-playing'));
        v.addEventListener('timeupdate', () => box.style.setProperty('--p', String(v.duration ? v.currentTime / v.duration : 0)));
        v.addEventListener('ended', () => { box.classList.add('is-ended'); box.classList.remove('is-playing'); });
        v.addEventListener('click', () => { box.classList.remove('is-ended'); v.currentTime = 0; v.play().catch(() => {}); });
      });
      }
      initPage();
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
